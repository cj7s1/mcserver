      "help": "The name of the new game (letters, digits, spaces, _ and -). Empty: the server's name and the date.",
      "key": "session_name",
      "label": "Session name",
      "nullable": true,
      "type": "string"
     }
    ],
    "set_aside_folder": "",
    "via_api": true
   }
