   "default_memory_mb": 12288,
   "default_stop_timeout": 120,
   "fixed_version": {
    "help": "Players' game clients update themselves, so the server always runs the current stable build: it checks for an update at every start. There is no version to choose.",
    "id": "stable",
    "label": "Steam stable branch"
   },
   "id": "satisfactory",
   "label": "Satisfactory",
   "memory_model": "plain",
   "min_memory_mb": 8192,
   "notes": [
    "Dedicated server on the wolveix/satisfactory-server image; the game (about 2.9 GB) is downloaded on the first start and checked for updates at every start, so players' clients and the server stay on Steam's stable build. 'Update' means restart.",
    "Needs at least 8 GB of memory (12 GB by default, 16 GB for big factories or more than 4 players).",
    "The panel claims the server before publishing its ports and asks you to choose a join password or an open server. Forward the game port on UDP and TCP, and the messaging port on TCP."
   ],
   "options": [
    {
     "default": null,
     "help": "Satisfactory lets anyone who reaches the server log in as a client until a client password is set. Choose explicitly: a join password (enter it on the last step), or open to anyone who knows the address.",
     "key": "access",
     "label": "Who may join",
     "option_labels": {
      "open": "Open to anyone who knows the address",
      "password": "A join password"
     },
     "options": [
      "password",
      "open"
     ],
     "pinned": false,
     "type": "enum"
    }
   ],
   "player_list_labels": {},
   "player_name_pattern": "^[A-Za-z0-9_]{1,16}$",
   "ports": [
    {
     "container_port": 7777,
     "default_host_port": 7777,
     "help": "Players connect to this port (UDP). The server's API uses the same number on TCP.",
     "label": "Game",
     "name": "game",
     "protocol": "udp"
    },
    {
     "container_port": 7777,
     "default_host_port": 7777,
     "help": "The HTTPS API the game client's Server Manager talks to: always the same number as the game port.",
     "label": "Server API",
     "name": "api",
     "protocol": "tcp",
     "same_port_as": "game"
    },
    {
     "container_port": 8888,
     "default_host_port": 8888,
     "help": "TCP port the server advertises to players for reliable messages (Satisfactory's default is 8888).",
     "label": "Reliable messaging",
     "name": "messaging",
     "protocol": "tcp"
    }
   ],
   "secrets": [
    {
     "clear_opens": true,
     "help": "Players enter it in the game to join. Clearing it later opens the server to anyone who knows its address.",
     "key": "client_password",
     "label": "Join password (client password)",
     "link": "",
     "required": false,
     "required_when": {
      "option": "access",
      "value": "password"
     }
    }
   ],
   "setup_steps": [
    {
     "help": "Whoever reaches an unclaimed Satisfactory server first owns it, so the panel claims it through its API on the internal network before any port is published. The admin password is this server's control secret; the panel keeps an API token for itself (encrypted).",
     "id": "claim",
     "kind": "auto",
     "label": "Claim the server",
     "secret": null
    },
    {
     "help": "Sets the client password you chose, or confirms that the server is open to anyone who knows its address.",
     "id": "access",
     "kind": "auto",
     "label": "Join password",
     "secret": null
    },
    {
     "help": "Keeps the game the server plays; without one it loads the newest save of the server's session (or the newest save there is), and creates a new game only when there is no save at all.",
     "id": "new_game",
     "kind": "auto",
     "label": "Load or create the game",
     "secret": null
    },
    {
     "help": "Recreates the container with the game, API and messaging ports published. Until then nobody outside the panel can reach the server.",
     "id": "publish",
     "kind": "auto",
     "label": "Publish the ports",
     "secret": null
    }
   ],
   "variants": [],
