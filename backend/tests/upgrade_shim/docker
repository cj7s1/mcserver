#!/bin/bash
# Stand-in for `docker` in backend/tests/test_upgrade_script.py: it starts nothing and never
# reaches a real Docker. deploy/scripts/upgrade.sh runs against it; the "world" (containers,
# image names, applied database migrations) is a few text files in $FAKE, and files named after
# a toggle make one step fail. What it changed is appended to $FAKE/events.log.
#
#   containers   ID|SERVICE|STATE|ONEOFF|IMAGE_NAME|IMAGE_ID|HEALTH[|NAME]   (the Compose project;
#                without NAME a container is called mcpanel-<service>-1)
#   servers      ID|STATE                                           (Minecraft server containers)
#   images       NAME|IMAGE_ID
#   labels       IMAGE_ID|REVISION                                  (io.mcpanel.revision)
#   migs         APP NAME                                           (last applied migration per app)
#   code/<id>    APP NAME                                           (last migration the code of an image has)
#   jobs         QUEUED|RUNNING
#   servers_db   ID|NAME|GAME|PORT|ARCHIVED                         (rows of instances_instance; GAME "-"
#                while the game column is dropped, ARCHIVED yes|no)
#   side_games   ID|GAME|PORT                                       (mcpanel_rollback_other_games)
# Toggles: fail_pull new_pg fail_build fail_up hang_up unhealthy_panel db_down fail_dump
#          fail_plan irreversible_<app> fail_unmigrate_<app> fail_restore redis_volume
#          slow_migrations (the panel applies its migrations only while it is being stopped)
#          hang_check (the migration check of the new image stays until $FAKE/release exists)
#          panel_not_started (a file with a number: that many times `compose up` ends without an
#          error and leaves the panel container "created"; "always" = every time)
#          keep_agent (`compose up` leaves a running agent container as it is, whatever the
#          image name points at now) rebuild_ids (every build gives the images new ids)
#          games_busy (a job holds a server of another game) fail_archive (archiving fails after
#          the first server) archive_misses (archiving records only the first server)
#          games_check_blind (the check sees nothing)
#
# `manage rollback_other_games` (the check, `compose run`) and its --archive (`exec` into the panel)
# work on servers_db and side_games the way the real command does; `migrate --plan` and undoing
# instances 0005/0006 refuse like their guard while a server of another game is not in side_games
# (so LOST cannot happen any more unless the guard is gone); undoing instances 0005 drops
# the game column (a server of another game that is not in side_games: event LOST <id>) after the
# recorded servers that share a port number got one above 65535 (migration 0007 undone), and fails
# like the unique index when a number is still shared; applying instances 0007 puts side_games back.
#
# `compose up` treats a container that an interrupted `up` left under its temporary name
# (<12 hex digits>_mcpanel-<service>-1) the way Compose 5.7 does: see the comment there.
# It also notes how it was started: "UP-ENV own-session|callers-session hup-ignored|hup-default".
set -u
F=${FAKE:?FAKE is not set}
printf 'docker %s\n' "$*" >>"$F/calls.log"
event() { printf '%s\n' "$*" >>"$F/events.log"; }
unhandled() {
    printf 'fake docker: unhandled: %s\n' "$*" | tee -a "$F/unhandled.log" >&2
    exit 97
}

img_id() { # name or id -> id
    local ref="$1" name id
    while IFS='|' read -r name id; do
        if [ "$name" = "$ref" ] || [ "$id" = "$ref" ]; then
            printf '%s\n' "$id"
            return 0
        fi
    done <"$F/images"
    return 1
}
img_set() { # name id
    grep -v -F "$1|" "$F/images" >"$F/images.tmp"
    printf '%s|%s\n' "$1" "$2" >>"$F/images.tmp"
    mv "$F/images.tmp" "$F/images"
}
cfield() { # container id, field number
    local line
    line=$(grep "^$1|" "$F/containers") || return 1
    printf '%s\n' "$line" | cut -d'|' -f"$2"
}
cname() { # container id -> its name
    local name
    name=$(cfield "$1" 8)
    printf '%s\n' "${name:-mcpanel-$(cfield "$1" 2)-1}"
}
is_temp_name() { [[ "$1" =~ ^[0-9a-f]{12}_ ]]; }
# upgrade.sh stops several containers at once: one writer of the containers file at a time
lock() {
    local tries=0
    until mkdir "$F/lock" 2>/dev/null; do
        tries=$((tries + 1))
        [ "$tries" -lt 500 ] || break
        sleep 0.01
    done
}
unlock() { rmdir "$F/lock" 2>/dev/null; }
code_file() { printf '%s/code/%s' "$F" "$(printf '%s' "$1" | tr ':/' '__')"; }
is_new_layout_image() { case "$1" in *panel-new*) return 0 ;; esac; return 1; }
image_of_service() {
    case "$1" in
        postgres) echo postgres:16-alpine ;;
        redis) echo redis:7-alpine ;;
        agent) echo "mcpanel/agent:${MCPANEL_IMAGE_TAG:-local}" ;;
        *) echo "mcpanel/panel:${MCPANEL_IMAGE_TAG:-local}" ;;
    esac
}
services_of() { # the service names of a compose file of the test site (two spaces, a name, a colon)
    sed -n '/^services:/,/^[a-z]/{s/^  \([a-z][a-z-]*\):$/\1/p}' "$1" | sort
}
set_mig() { # app name|zero
    grep -v "^$1 " "$F/migs" >"$F/migs.tmp"
    [ "$2" = zero ] || printf '%s %s\n' "$1" "$2" >>"$F/migs.tmp"
    sort "$F/migs.tmp" >"$F/migs"
    rm -f "$F/migs.tmp"
}
migrate_forward() { # image id: what the panel does when it starts
    local app mig cur
    [ -f "$(code_file "$1")" ] || return 0
    while read -r app mig; do
        [ -n "$app" ] || continue
        cur=$(grep "^$app " "$F/migs" | cut -d' ' -f2)
        if [[ -z "$cur" || "$cur" < "$mig" ]]; then
            set_mig "$app" "$mig"
            [ "$app" = instances ] && games_forward "$cur" "$mig"
        fi
    done <"$(code_file "$1")"
}

# --- the servers of other games (servers_db, side_games) ---------------------------------------
num() { # migration name -> its number
    local n=${1%%_*}
    case "$n" in '' | *[!0-9]*) n=0 ;; esac
    echo $((10#$n))
}
db_write() { # replaces servers_db with standard input
    cat >"$F/servers_db.tmp"
    mv "$F/servers_db.tmp" "$F/servers_db"
}
games_forward() { # instances went from $1 to $2: 0005 adds the column (default minecraft), 0007 restores
    [ -f "$F/servers_db" ] || return 0
    local id name game port archived sgame sport
    if [ "$(num "$1")" -lt 5 ] && [ "$(num "$2")" -ge 5 ]; then
        while IFS='|' read -r id name game port archived; do
            [ "$game" = - ] && game=minecraft
            printf '%s|%s|%s|%s|%s\n' "$id" "$name" "$game" "$port" "$archived"
        done <"$F/servers_db" | db_write
    fi
    if [ "$(num "$1")" -lt 7 ] && [ "$(num "$2")" -ge 7 ] && [ -f "$F/side_games" ]; then
        while IFS='|' read -r id name game port archived; do
            line=$(grep "^$id|" "$F/side_games") && IFS='|' read -r _ sgame sport <<<"$line" && {
                game=$sgame
                port=$sport
                archived=yes
            }
            printf '%s|%s|%s|%s|%s\n' "$id" "$name" "$game" "$port" "$archived"
        done <"$F/servers_db" | db_write
        event "RESTORE-OTHER-GAMES $(wc -l <"$F/side_games" | tr -d ' ')"
        rm -f "$F/side_games"
    fi
}
games_unrecorded() { # instances from $1 down to $2 undoes 0005 while servers of other games are not in side_games
    [ -f "$F/servers_db" ] || return 1
    [ "$(num "$1")" -ge 5 ] && [ "$(num "$2")" -lt 5 ] || return 1
    local id name game port archived
    while IFS='|' read -r id name game port archived; do
        [ "$game" = minecraft ] || [ "$game" = - ] && continue
        grep -q "^$id|" "$F/side_games" 2>/dev/null || return 0
    done <"$F/servers_db"
    return 1
}
games_backward() { # instances goes from $1 down to $2; fails like the guard of 0006 and the unique index
    [ -f "$F/servers_db" ] || return 0
    [ "$(num "$1")" -ge 5 ] && [ "$(num "$2")" -lt 5 ] || return 0
    if games_unrecorded "$1" "$2"; then
        echo "RuntimeError: Undoing instances 0006 would drop what these servers of other games are"
        return 1
    fi
    local id name game port archived n=65536
    if [ "$(num "$1")" -ge 7 ] && [ -f "$F/side_games" ]; then # 0007 undone: the rollback ports
        while IFS='|' read -r id name game port archived; do
            if grep -q "^$id|" "$F/side_games" && [ "$(cut -d'|' -f4 "$F/servers_db" | grep -c -x "$port")" -gt 1 ]; then
                port=$n
                n=$((n + 1))
            fi
            printf '%s|%s|%s|%s|%s\n' "$id" "$name" "$game" "$port" "$archived"
        done <"$F/servers_db" | db_write
    fi
    if [ -n "$(cut -d'|' -f4 "$F/servers_db" | sort | uniq -d)" ]; then
        echo 'django.db.utils.IntegrityError: could not create unique index "unique_game_port_per_node"'
        return 1
    fi
    while IFS='|' read -r id name game port archived; do
        if [ "$game" != minecraft ] && [ "$game" != - ] && ! grep -q "^$id|" "$F/side_games" 2>/dev/null; then
            event "LOST $id"
        fi
        printf '%s|%s|-|%s|%s\n' "$id" "$name" "$port" "$archived"
    done <"$F/servers_db" | db_write
}
games_report() { # what the real command prints; returns 3 when something must be archived
    local id name game port archived found=0
    [ -f "$F/servers_db" ] || return 0
    while IFS='|' read -r id name game port archived; do
        [ "$game" = minecraft ] || [ "$game" = - ] && continue
        [ "$found" = 1 ] || echo "Servers of games other than Minecraft (the version the rollback goes back to does not know them):"
        found=1
        echo "  $id  '$name'  $game$([ "$archived" = yes ] && printf ', archived already')"
    done <"$F/servers_db"
    if [ -n "$(cut -d'|' -f4 "$F/servers_db" | sort | uniq -d)" ]; then
        echo "Port numbers several servers of one node share (the old database allows each number once per node):"
        cut -d'|' -f4 "$F/servers_db" | sort | uniq -d | while read -r port; do echo "  port $port"; done
        found=1
    fi
    [ "$found" = 1 ] && return 3
    return 0
}
games_check() {
    event "GAMES-CHECK ${*#*rollback_other_games }"
    if [ -f "$F/games_check_blind" ]; then # a check that misses them: the plan of the undo still refuses
        echo "No server of another game, no shared port number, no long player name: nothing to do."
        return 0
    fi
    if [ -f "$F/games_busy" ]; then
        games_report
        echo "  'busy': an operation is in progress (Backup: busy): wait until it is done"
        echo "CommandError: the rollback cannot go on now (see above); nothing was changed" >&2
        return 4
    fi
    games_report && {
        echo "No server of another game, no shared port number, no long player name: nothing to do."
        return 0
    }
    echo "CommandError: the rollback would lose or be refused what is listed above" >&2
    return 3
}
games_archive() {
    local id name game port archived count=0 failed=0
    event "GAMES-ARCHIVE ${*#*rollback_other_games }"
    games_report >/dev/null && return 0
    exec 3>&1 # what it says; the loop's own output is the new servers_db
    while IFS='|' read -r id name game port archived; do
        if [ "$failed" = 0 ] && [ "$game" != minecraft ] && [ "$game" != - ]; then
            if [ -f "$F/fail_archive" ] && [ "$count" = 1 ]; then
                echo "  '$name': 'Stop server: $name (before a rollback)' failed: the agent did not answer (toggle)" >&3
                echo "CommandError: archiving did not finish (see above)" >&2
                failed=1
                printf '%s|%s|%s|%s|%s\n' "$id" "$name" "$game" "$port" "$archived"
                continue
            fi
            count=$((count + 1))
            if [ ! -f "$F/archive_misses" ] || [ "$count" = 1 ]; then
                grep -q "^$id|" "$F/side_games" 2>/dev/null || printf '%s|%s|%s\n' "$id" "$game" "$port" >>"$F/side_games"
            fi
            event "ARCHIVE $id"
            echo "  '$name': stopped (graceful stop through the agent)" >&2
            echo "  '$name': archived, recorded" >&3
            archived=yes
        fi
        printf '%s|%s|%s|%s|%s\n' "$id" "$name" "$game" "$port" "$archived"
    done <"$F/servers_db" >"$F/servers_db.new"
    mv "$F/servers_db.new" "$F/servers_db"
    [ "$failed" = 0 ] || return 4
    echo "Done: $count server(s) archived and recorded in mcpanel_rollback_other_games."
}

case "${1:-}" in
    version)
        echo 29.8.2
        exit 0
        ;;
    compose)
        shift
        file="$PWD/docker-compose.yml"
        dry=0
        while [ $# -gt 0 ]; do
            case "$1" in
                -f)
                    file="$2"
                    shift 2
                    ;;
                --project-directory) shift 2 ;;
                --dry-run)
                    dry=1
                    shift
                    ;;
                *) break ;;
            esac
        done
        sub="${1:-}"
        [ $# -gt 0 ] && shift
        case "$sub" in
            version)
                echo "Docker Compose version 5.6.1"
                exit 0
                ;;
            config)
                [ -f "$file" ] || exit 1
                case " $* " in
                    *" --services "*) services_of "$file" ;;
                    *" --images "*) for s in $(services_of "$file"); do image_of_service "$s"; done ;;
                    *)
                        echo "name: mcpanel"
                        echo "services: {}"
                        ;;
                esac
                exit 0
                ;;
            pull)
                [ -f "$F/fail_pull" ] && {
                    echo "pull failed (toggle)" >&2
                    exit 1
                }
                [ -f "$F/new_pg" ] && img_set postgres:16-alpine sha256:pg-newer
                echo " postgres Pulled"
                exit 0
                ;;
            build)
                rev=$(git -C "$PWD" rev-parse --short=12 HEAD)
                [ -f "$F/rebuild_ids" ] && rev="$rev-b$(grep -c '^BUILD agent' "$F/events.log")"
                kind=old
                [ -f "$PWD/scripts/upgrade.sh" ] && kind=new
                img_set "$(image_of_service agent)" "sha256:agent-$kind-$rev"
                event "BUILD agent sha256:agent-$kind-$rev"
                if [ -f "$F/fail_build" ]; then
                    echo "build of panel failed (toggle; the agent image was tagged already)" >&2
                    exit 1
                fi
                id="sha256:panel-$kind-$rev"
                img_set "$(image_of_service panel)" "$id"
                mkdir -p "$F/code"
                : >"$(code_file "$id")"
                for dir in "$PWD"/../backend/apps/*/migrations; do
                    app=$(basename "$(dirname "$dir")")
                    last=$(find "$dir" -maxdepth 1 -name '[0-9]*.py' -printf '%f\n' | sort | tail -n 1)
                    [ -n "$last" ] && printf '%s %s\n' "$app" "${last%.py}" >>"$(code_file "$id")"
                done
                printf '%s|%s\n' "$id" "${MCPANEL_REVISION:-unknown}" >>"$F/labels"
                event "BUILD panel $id"
                echo " panel Built"
                exit 0
                ;;
            run)
                # like the real one: standard input is attached and read to its end
                timeout 0.3 cat >/dev/null
                panel=$(img_id "$(image_of_service panel)")
                args="$*"
                case "$args" in
                    *"manage rollback_other_games "*)
                        games_check "$args"
                        exit $?
                        ;;
                    *"migrate --check"*)
                        if [ -f "$F/hang_check" ]; then # stays here until the test lets go (or the session is hung up)
                            event "CHECK-WAIT"
                            while [ -d "$F" ] && [ ! -e "$F/release" ]; do sleep 0.05; done
                        fi
                        while read -r app name; do
                            [ -n "$app" ] || continue
                            grep -q -x "$app $name" "$F/migs" || exit 1
                        done <"$(code_file "$panel")"
                        exit 0
                        ;;
                    *"showmigrations --plan"*)
                        while read -r app name; do
                            [ -n "$app" ] || continue
                            if grep -q -x "$app $name" "$F/migs"; then echo "[X]  $app.$name"; else echo "[ ]  $app.$name"; fi
                        done <"$(code_file "$panel")"
                        exit 0
                        ;;
                    *"manage migrate "*)
                        target="${*: -1}"
                        app="${*: -2:1}"
                        # only code that has the applied migration can undo it
                        applied=$(grep "^$app " "$F/migs" | cut -d' ' -f2)
                        known=$(grep "^$app " "$(code_file "$panel")" | cut -d' ' -f2)
                        if [ -n "$applied" ] && [[ "$known" < "$applied" ]]; then
                            echo "CommandError: this code does not have migration $app.$applied"
                            exit 1
                        fi
                        case "$args" in
                            *"migrate --plan "*)
                                [ -f "$F/fail_plan" ] && {
                                    echo "django.db.utils.OperationalError (toggle)"
                                    exit 1
                                }
                                event "PLAN $app -> $target"
                                echo "Planned operations:"
                                echo "$app.$applied"
                                if [ "$app" = instances ] && games_unrecorded "$applied" "$target"; then
                                    # migrations 0005/0006: their guard (apps/instances/migrations/_other_games_guard.py)
                                    echo "    Raw Python operation -> IRREVERSIBLE (other games)"
                                elif [ -f "$F/irreversible_$app" ]; then
                                    echo "    Raw Python operation -> IRREVERSIBLE"
                                else
                                    echo "    Undo Add field x to y"
                                fi
                                exit 0
                                ;;
                        esac
                        [ -f "$F/fail_unmigrate_$app" ] && {
                            echo "django.db.migrations.exceptions.IrreversibleError (toggle)"
                            exit 1
                        }
                        if [ "$app" = instances ]; then
                            games_backward "$applied" "$target" || exit 1
                        fi
                        set_mig "$app" "$target"
                        event "UNMIGRATE $app -> $target"
                        exit 0
                        ;;
                esac
                unhandled "compose run $args"
                ;;
            up)
                if [ "$dry" = 1 ]; then
                    # like Compose: every event twice, and of the containers the file no longer has only
                    # the orphans (redis still is a service of the file, behind a profile)
                    wanted=" $(services_of "$file" | tr '\n' ' ') redis "
                    while IFS='|' read -r _id service _rest; do
                        case "$wanted" in *" $service "*) continue ;; esac
                        echo " DRY-RUN MODE -  Container mcpanel-$service-1  Stopping"
                        echo " DRY-RUN MODE -  Container mcpanel-$service-1  Stopping"
                        echo " DRY-RUN MODE -  Container mcpanel-$service-1  Removed"
                    done <"$F/containers"
                    echo " DRY-RUN MODE -  Container mcpanel-panel-1  Recreate"
                    echo " DRY-RUN MODE -  Container mcpanel-panel-1  Recreate"
                    exit 0
                fi
                # how it was started: in a session of its own (setsid), with SIGHUP ignored (inherited or nohup)?
                read -r _pid _comm _state _ppid _pgrp sid _rest </proc/$$/stat
                mask=$(sed -n 's/^SigIgn:[[:space:]]*//p' /proc/$$/status)
                session="callers-session"
                [ "$sid" = "$$" ] && session="own-session"
                hup="hup-default"
                (((16#$mask & 1) == 1)) && hup="hup-ignored"
                event "UP-ENV $session $hup"
                if [ -f "$F/hang_up" ]; then # stays in `up` until the test lets go (or the session is hung up)
                    event "UP-WAIT"
                    # (it may run in a session of its own, where no signal of the test gets to it: it
                    # also ends when the test's folder is gone)
                    while [ -d "$F" ] && [ ! -e "$F/release" ]; do sleep 0.05; done
                fi
                [ -f "$F/fail_up" ] && {
                    echo "compose up failed (toggle)" >&2
                    exit 1
                }
                # A container an interrupted `up` left behind under its temporary name. What Compose
                # 5.7 was seen to do with it (docker compose up -d, real containers):
                #   the layout of the file is the one the stopped original was made for (a rollback):
                #     it removes the replacement and does not start the original; services that
                #     depend on it make the command fail ("dependency failed to start")
                #   otherwise, while the stopped original is still there: it removes the original,
                #     leaves the replacement "created" and ends without an error
                #   otherwise (only the replacement is left): it starts it, and the name stays
                temp=""
                while IFS='|' read -r id _service _state _oneoff _image _image_id _health name; do
                    is_temp_name "${name:-}" && temp="$temp $id"
                done <"$F/containers"
                if [ -n "$temp" ] && services_of "$file" | grep -q -x worker; then
                    for id in $temp; do
                        echo " Container $(cname "$id") Removed" >&2
                        grep -v "^$id|" "$F/containers" >"$F/containers.tmp"
                        mv "$F/containers.tmp" "$F/containers"
                    done
                    event "UP-HALF removed the replacement, started nothing"
                    echo "dependency failed to start: container mcpanel-panel-1 exited (143)" >&2
                    exit 1
                fi
                : >"$F/containers.new"
                n=0
                for s in $(services_of "$file"); do
                    n=$((n + 1))
                    name=$(image_of_service "$s")
                    id=$(img_id "$name") || {
                        echo "no such image: $name" >&2
                        exit 1
                    }
                    replacement=""
                    for t in $temp; do [ "$(cfield "$t" 2)" = "$s" ] && replacement=$t; done
                    if [ -n "$replacement" ]; then
                        if [ "$(grep -c "^[^|]*|$s|" "$F/containers")" -gt 1 ]; then
                            grep "^$replacement|" "$F/containers" >>"$F/containers.new" # still "created"
                            event "UP-HALF removed the original of $s, did not start the replacement"
                        else
                            printf '%s|%s|running|False|%s|%s|healthy|%s\n' "$replacement" "$s" "$(cfield "$replacement" 5)" "$(cfield "$replacement" 6)" "$(cname "$replacement")" >>"$F/containers.new"
                            event "UP-HALF started the replacement of $s under its temporary name"
                            [ "$s" = panel ] && migrate_forward "$(cfield "$replacement" 6)"
                        fi
                        continue
                    fi
                    if [ "$s" = agent ] && [ -f "$F/keep_agent" ] && grep -q "^[^|]*|agent|running|" "$F/containers"; then
                        grep "^[^|]*|agent|running|" "$F/containers" >>"$F/containers.new" # "Running": not made again
                        continue
                    fi
                    health=healthy
                    state=running
                    if [ "$s" = panel ] && [ -f "$F/unhealthy_panel" ]; then health=unhealthy; fi
                    if [ "$s" = panel ] && [ -f "$F/panel_not_started" ]; then
                        left=$(cat "$F/panel_not_started")
                        if [ "$left" = always ] || [ "$left" -gt 0 ]; then
                            state=created
                            health=-
                            [ "$left" = always ] || echo $((left - 1)) >"$F/panel_not_started"
                        fi
                    fi
                    printf 'c%s%s|%s|%s|False|%s|%s|%s\n' "$n" "$(date +%N)" "$s" "$state" "$name" "$id" "$health" >>"$F/containers.new"
                    if [ "$s" = panel ] && [ "$state" = running ] && [ ! -f "$F/slow_migrations" ]; then migrate_forward "$id"; fi
                done
                mv "$F/containers.new" "$F/containers"
                event "UP $(services_of "$file" | tr '\n' ' ')"
                echo " Container up (fake)"
                exit 0
                ;;
        esac
        unhandled "compose $sub $*"
        ;;
    ps)
        case "$*" in
            *io.mcpanel.managed=true*)
                while IFS='|' read -r id state; do
                    case "$state" in exited | created | dead) printf '%s\n' "$id" ;; esac
                done <"$F/servers"
                ;;
            *)
                while IFS='|' read -r id service state oneoff _rest; do
                    [ -n "$id" ] && printf '%s %s %s %s\n' "$id" "$service" "$state" "$oneoff"
                done <"$F/containers"
                ;;
        esac
        exit 0
        ;;
    inspect)
        fmt="$3"
        id="$4"
        grep -q "^$id|" "$F/containers" || {
            echo "Error: No such object: $id" >&2
            exit 1
        }
        service=$(cfield "$id" 2)
        state=$(cfield "$id" 3)
        image_name=$(cfield "$id" 5)
        image_id=$(cfield "$id" 6)
        health=$(cfield "$id" 7)
        case "$fmt" in
            *'index .Config.Labels'*) grep -F "$image_id|" "$F/labels" | tail -n 1 | cut -d'|' -f2 ;;
            '{{.Image}}') echo "$image_id" ;;
            '{{.Config.Image}}') echo "$image_name" ;;
            '{{.Name}}|'*) echo "/$(cname "$id")|$health|$image_name|$image_id" ;;
            '{{.Name}}') echo "/$(cname "$id")" ;;
            '{{.State.Status}}/'*) echo "$state/$health" ;;
            *Health.Log*) echo "unhealthy: fake" ;;
            *) unhandled "inspect $fmt" ;;
        esac
        exit 0
        ;;
    exec)
        shift
        [ "$1" = -i ] && shift
        id="$1"
        shift
        all="$*"
        case "$all" in
            "python manage.py rollback_other_games --archive "*)
                [ "$(cfield "$id" 2)" = panel ] && [ "$(cfield "$id" 3)" = running ] || {
                    echo "Error response from daemon: container $id is not running" >&2
                    exit 1
                }
                games_archive "$all"
                exit $?
                ;;
            *_before_restore_*)
                # $1 $2 $3 = sh -c SCRIPT, then: sh SUFFIX MODE; the dump is on standard input
                suffix="$5"
                dump=$(cat)
                [ -f "$F/fail_restore" ] && {
                    echo "psql: error (toggle); the database mcpanel was not changed" >&2
                    exit 4
                }
                : >"$F/migs.tmp"
                while read -r _dash tag app name; do
                    [ "$tag" = MIG ] && printf '%s %s\n' "$app" "$name" >>"$F/migs.tmp"
                done <<<"$dump"
                sort "$F/migs.tmp" >"$F/migs"
                rm -f "$F/migs.tmp"
                event "RESTORE $suffix $6 lines=$(wc -l <<<"$dump" | tr -d ' ')"
                echo "mcpanel_before_restore_$suffix"
                exit 0
                ;;
            *'printf %s'*POSTGRES_DB*) # the name of the database
                printf mcpanel
                exit 0
                ;;
            *psql*)
                sql=$(cat)
                case "$sql" in
                    *jobs_job*) cat "$F/jobs" 2>/dev/null || echo "0|0" ;;
                    *django_migrations*)
                        [ -f "$F/db_down" ] && exit 2
                        cat "$F/migs"
                        ;;
                esac
                exit 0
                ;;
            *pg_dump*)
                [ -f "$F/fail_dump" ] && {
                    echo "pg_dump: error (toggle)" >&2
                    exit 1
                }
                echo "--"
                echo "-- PostgreSQL database dump"
                echo "--"
                while read -r app name; do echo "-- MIG $app $name"; done <"$F/migs"
                echo "COPY public.accounts_user (id, username) FROM stdin;"
                event "DUMP"
                exit 0
                ;;
            "test -f /run/mcpanel/supervisor.json")
                is_new_layout_image "$(cfield "$id" 6)"
                exit $?
                ;;
            *mcpanel-supervise.py*)
                echo "phase running, supervisor pid 7, status written 1 s ago"
                exit 0
                ;;
            *'[b]eat'*)
                service=$(cfield "$id" 2)
                if [ "$service" = beat ] || { [ "$service" = panel ] && is_new_layout_image "$(cfield "$id" 6)"; }; then echo 1; else echo 0; fi
                exit 0
                ;;
        esac
        unhandled "exec $all"
        ;;
    image)
        case "${2:-}" in
            inspect)
                if [ "$3" = -f ]; then
                    img_id "$5" || exit 1
                else
                    img_id "$3" >/dev/null || exit 1
                    echo "[]"
                fi
                exit 0
                ;;
            tag)
                id=$(img_id "$3") || {
                    echo "no such image $3" >&2
                    exit 1
                }
                img_set "$4" "$id"
                event "TAG $4 = $id"
                exit 0
                ;;
            rm)
                grep -v -F "$3|" "$F/images" >"$F/images.tmp"
                mv "$F/images.tmp" "$F/images"
                event "UNTAG $3"
                exit 0
                ;;
        esac
        unhandled "image $*"
        ;;
    stop)
        id="$4"
        event "STOP $(cfield "$id" 2)"
        if [ "$(cfield "$id" 2)" = panel ] && [ "$(cfield "$id" 3)" = running ] && [ -f "$F/slow_migrations" ]; then
            migrate_forward "$(cfield "$id" 6)"
        fi
        lock
        sed -i "s/^\($id|[^|]*\)|running|/\1|exited|/" "$F/containers"
        unlock
        echo "$id"
        exit 0
        ;;
    rm)
        shift
        for id in "$@"; do
            grep -q "^$id|" "$F/containers" || {
                echo "Error response from daemon: No such container: $id" >&2
                exit 1
            }
            [ "$(cfield "$id" 3)" != running ] || {
                echo "Error response from daemon: cannot remove container \"$(cname "$id")\": container is running" >&2
                exit 1
            }
            if [ "$(cname "$id")" = "mcpanel-$(cfield "$id" 2)-1" ]; then
                event "RM $(cfield "$id" 2)"
            else
                event "RM $(cname "$id")"
            fi
            grep -v "^$id|" "$F/containers" >"$F/containers.tmp"
            mv "$F/containers.tmp" "$F/containers"
        done
        exit 0
        ;;
    rename)
        id="$2"
        new="$3"
        row=$(grep "^$id|" "$F/containers") || {
            echo "Error response from daemon: No such container: $id" >&2
            exit 1
        }
        event "RENAME $(cname "$id") -> $new"
        grep -v "^$id|" "$F/containers" >"$F/containers.tmp"
        printf '%s|%s\n' "$(printf '%s\n' "$row" | cut -d'|' -f1-7)" "$new" >>"$F/containers.tmp"
        mv "$F/containers.tmp" "$F/containers"
        exit 0
        ;;
    volume)
        [ -f "$F/redis_volume" ]
        exit $?
        ;;
    logs)
        echo "(fake logs)"
        exit 0
        ;;
esac
unhandled "$*"
