# MCPanel deployment settings for deploy/docker-compose.yml.
#
# Create your .env from this file with random secrets (refuses to overwrite):
#   ./scripts/generate-secrets.sh
# or copy it by hand and fill every secret with e.g.:
#   openssl rand -hex 32
#
# Keep .env private (chmod 600). Never commit it. Changing MCPANEL_SECRET_KEY later
# makes stored provider API keys, node tokens and webhook URLs unreadable unless the old
# key is kept in MCPANEL_SECRET_KEY_FALLBACKS (docs/SECURITY.md, "Rotating the secret key").

# --- Secrets (required) -------------------------------------------------------------
# Django signing/encryption key. 50+ random characters.
MCPANEL_SECRET_KEY=
# Only while rotating MCPANEL_SECRET_KEY: the previous key(s), comma-separated. Remove
# them after `docker compose exec panel python manage.py reencrypt_secrets`.
MCPANEL_SECRET_KEY_FALLBACKS=
# Shared bearer token between the panel and the node agent. 48+ random characters.
MCPANEL_AGENT_TOKEN=
# Password of the bundled PostgreSQL database (used by postgres and the panel).
POSTGRES_PASSWORD=
# Encryption password of all restic backup repositories. BACK THIS UP somewhere
# outside the server: without it, no backup can ever be restored.
AGENT_RESTIC_PASSWORD=

# --- First-run setup (recommended) -----------------------------------------------------
# Token the first-run setup page asks for before it creates the owner account. Set it
# BEFORE the first start (e.g. `openssl rand -hex 24`), otherwise whoever reaches the panel
# first can claim it. Only used while no account exists; empty = no token required.
MCPANEL_SETUP_TOKEN=

# --- Storage --------------------------------------------------------------------------
# Absolute host path for all server data (instances, staging, trash, agent state). It
# is mounted into the agent at the SAME path, because the agent passes instance
# directories to the Docker daemon as bind-mount sources.
#   Unraid: /mnt/user/appdata/mcpanel  (or /mnt/cache/appdata/mcpanel)
MCPANEL_DATA_DIR=/srv/mcpanel
# Optional separate absolute host path for restic backup repositories (e.g. an array
# share on Unraid). Empty = ${MCPANEL_DATA_DIR}/backups.
#   Unraid: /mnt/user/backups/mcpanel
MCPANEL_BACKUP_DIR=
# Optional absolute host path for the PostgreSQL data directory. Empty = the Docker
# named volume "postgres_data". On Unraid prefer a path outside docker.img, e.g.
# /mnt/user/appdata/mcpanel-db
MCPANEL_POSTGRES_DIR=

# --- Minecraft runtime ----------------------------------------------------------------
# UID/GID the Minecraft server processes run as and that own instance files.
#   Unraid: MC_UID=99 (nobody), MC_GID=100 (users)
MC_UID=1000
MC_GID=1000
# Host port range the panel allocates game ports from (one port per server).
MCPANEL_PORT_RANGE_START=25565
MCPANEL_PORT_RANGE_END=25665
# Host ports the agent accepts at all (game ports plus extra ports such as voice chat).
# Must include the range above.
AGENT_PORT_MIN=1024
AGENT_PORT_MAX=65535
# Upper bound for the memory limit of a single server container (MiB).
AGENT_MAX_MEMORY_MB=65536
# Longest time (seconds) Docker itself waits for a Minecraft server when the host or the Docker daemon
# stops. Stops from the panel use the server's own stop timeout. Keep 20 on Unraid: Unraid kills the
# Docker daemon 30 s after asking it to stop (docs/UNRAID-SHUTDOWN.md).
AGENT_SHUTDOWN_STOP_TIMEOUT=20

# A stopped server has no container: the panel removes the exited container about 10 s after a
# stop (its last console lines and exit state are kept) and creates a new one at the next start.
# Set to false to keep exited containers as before. First roll-out on a host that already has
# exited server containers: `docker compose exec panel python manage.py retire_stopped_containers --dry-run`.
MCPANEL_RETIRE_STOPPED_CONTAINERS=

# --- Web access -----------------------------------------------------------------------
# Address and port the panel is published on. The default only allows access from
# the Docker host itself. For LAN access set MCPANEL_BIND to the host's LAN IP (e.g.
# 192.168.1.10) or 0.0.0.0, and add that address to the two lists below.
MCPANEL_BIND=127.0.0.1
MCPANEL_PORT=8080
# Comma-separated host names/IPs the panel answers to (Django ALLOWED_HOSTS).
#   LAN example: localhost,127.0.0.1,192.168.1.10,tower.local
MCPANEL_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (scheme://host:port as typed in the browser) allowed to
# submit forms/API writes and open WebSockets. Must match MCPANEL_PORT.
#   LAN example: http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.10:8080
MCPANEL_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Addresses shown to players/users for connecting (informational only; the panel
# never configures port forwarding or DNS).
#   MCPANEL_LAN_ADDRESS: the host's LAN IP, e.g. 192.168.1.10
#   MCPANEL_PUBLIC_HOSTNAME: e.g. mc.example.com
MCPANEL_LAN_ADDRESS=
MCPANEL_PUBLIC_HOSTNAME=

# --- Reverse proxy / HTTPS ----------------------------------------------------------
# Set to true ONLY when an HTTPS reverse proxy (Nginx Proxy Manager, SWAG, Caddy,
# Traefik...) is in front of the panel. Then the panel trusts X-Forwarded-Proto /
# -Host / -For, and you should also set MCPANEL_SECURE_COOKIES=true and put the
# public https:// origin into MCPANEL_CSRF_TRUSTED_ORIGINS and its host name into
# MCPANEL_ALLOWED_HOSTS.
MCPANEL_BEHIND_TLS_PROXY=false
# Comma-separated IPs/CIDRs of the reverse proxy as the panel container sees it, i.e.
# the peers whose X-Forwarded-For is trusted when MCPANEL_BEHIND_TLS_PROXY=true. Empty =
# 127.0.0.1,::1 only, so behind a proxy every request appears to come from the proxy (one
# shared login rate limit, proxy IP in the audit log) until you set it. Use the proxy's
# exact address, e.g. 192.168.1.10 for Nginx Proxy Manager on the Unraid host, or its
# Docker address; `docker compose logs --tail 20 panel` shows the address requests come from.
# Do not trust whole private ranges (172.16.0.0/12 includes the Minecraft containers, which
# run third-party code) and never use "*": clients could then fake their IP address and
# bypass the login rate limit.
MCPANEL_FORWARDED_ALLOW_IPS=
# Mark session/CSRF cookies Secure (HTTPS only).
MCPANEL_SECURE_COOKIES=false
# Session lifetime in seconds (empty = 7 days).
MCPANEL_SESSION_AGE_SECONDS=

# --- Providers -------------------------------------------------------------------------
# Optional CurseForge API key (https://console.curseforge.com/). Needed for CurseForge
# modpacks; can also be entered later under System Settings.
CURSEFORGE_API_KEY=

# --- Notifications -----------------------------------------------------------------------
# Allow generic webhooks to private/LAN addresses (Home Assistant, ntfy, Gotify on your
# network). Loopback, link-local/cloud metadata addresses and MCPanel's own services (agent,
# database, Redis, node agents) are always refused. Set to false if every webhook target is
# on the internet.
MCPANEL_WEBHOOK_ALLOW_LAN=true

# --- Database -----------------------------------------------------------------------
POSTGRES_DB=mcpanel
POSTGRES_USER=mcpanel

# --- Operations -----------------------------------------------------------------------
# Time zone for logs and schedules (IANA name, e.g. Europe/Berlin).
TZ=UTC
# Log level of the panel's own messages (DEBUG, INFO, WARNING, ERROR) and JSON log lines. The panel
# container logs the lines of all its processes, each with the process name in front ([web],
# [worker], [periodic], [beat], [redis], [supervisor]); the periodic worker and the scheduler only
# log warnings and errors.
MCPANEL_LOG_LEVEL=INFO
MCPANEL_LOG_JSON=true
# Log level of the agent.
AGENT_LOG_LEVEL=INFO
# How many jobs (installs, backups, starts, stops...) can run at the same time: the number of
# processes of the job worker inside the panel container (empty = one per CPU core; 4 is plenty
# for a home server). The periodic worker next to it always has 2, whatever is set here.
MCPANEL_WORKER_CONCURRENCY=
# Job reliability (empty = the default in brackets; see backend/mcpanel/settings.py):
#   MCPANEL_CELERY_VISIBILITY_TIMEOUT  [86400] seconds before Redis hands an unacknowledged
#                                      job message to another worker; keep it above the longest job
#   MCPANEL_JOB_HEARTBEAT_SECONDS      [30] how often a running job reports that it is alive
#   MCPANEL_JOB_STALE_SECONDS          [300] a running job without a heartbeat for this long was
#                                      interrupted and is failed; must be >= 3x the heartbeat
#   MCPANEL_JOB_MAX_RUNTIME_HOURS      [48] a job still running after this is failed as hung (0 = off)
MCPANEL_CELERY_VISIBILITY_TIMEOUT=
MCPANEL_JOB_HEARTBEAT_SECONDS=
MCPANEL_JOB_STALE_SECONDS=
MCPANEL_JOB_MAX_RUNTIME_HOURS=
# Maximum size of a single upload through the panel in bytes (empty = 2 GiB).
MCPANEL_MAX_UPLOAD_BYTES=
# Timeout in seconds for panel -> agent requests (empty = 30).
MCPANEL_AGENT_TIMEOUT=
# Only when the DEFAULT node's agent is on another host (MCPANEL_AGENT_URL=https://...):
# its certificate fingerprint (python -m mcagent fingerprint on that host). Additional nodes
# are pinned in the UI instead (System -> Nodes). See DEPLOYMENT.md "Additional nodes".
MCPANEL_AGENT_TLS_FINGERPRINT=
# PEM bundle (path inside the panel container) of a private CA that signed agent certificates.
MCPANEL_AGENT_CA_BUNDLE=
# Tag for the locally built images mcpanel/panel and mcpanel/agent.
MCPANEL_IMAGE_TAG=local

# --- Redis (normally nothing to set) ----------------------------------------------------
# Redis (job queue, live events, cache) runs inside the panel container, reachable only through
# a Unix socket there, and keeps nothing on disk: jobs and state are in PostgreSQL, and jobs
# that were still waiting are sent again when the panel starts.
# To run Redis as its own container instead (the layout before it moved into the panel
# container, and the way back if it ever misbehaves there), uncomment BOTH lines and run
# `./scripts/upgrade.sh run --no-build`. To return to the default, comment them out again and
# run the same command: it also removes the redis container.
#COMPOSE_PROFILES=external-redis
#MCPANEL_REDIS_URL=redis://redis:6379/0

# --- Advanced agent settings (not passed by default) ----------------------------------
# Settings such as AGENT_RUNTIME_EXTRA_ENV (JSON env injected into every Minecraft
# container, e.g. an egress proxy), AGENT_RUNTIME_CA_BUNDLE / AGENT_RUNTIME_JAVA_TRUSTSTORE
# (host paths mounted read-only into servers), AGENT_FETCH_ALLOWED_HOSTS or
# AGENT_ALLOWED_NETWORKS belong in deploy/docker-compose.override.yml under
# services.agent.environment (see agent/mcagent/config.py). Do not set them to empty
# strings: leave them out to keep the defaults.
#
# Networks with a TLS-intercepting egress proxy: the panel calls Mojang, Modrinth, CurseForge
# and FTB over HTTPS. In docker-compose.override.yml give it HTTPS_PROXY (if required) and
# SSL_CERT_FILE pointing at a read-only mounted CA bundle, e.g.
#   services:
#     panel: { environment: { SSL_CERT_FILE: /run/ca.pem }, volumes: ["/path/ca.pem:/run/ca.pem:ro"] }
# Image builds behind such a proxy: see the header comments of backend/Dockerfile.
