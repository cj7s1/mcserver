<FILE Name="/usr/local/emhttp/plugins/mcpanel/mcpanel.css" Mode="0644">
<INLINE>
<![CDATA[
/* MCPanel plugin page: no colours of its own, so it follows every Unraid theme (black, white, gray, azure). */
.mcp h2 { margin: 1.6em 0 0.4em; font-size: 1.3em; }
.mcp .mcp-hidden { display: none !important; }
.mcp .mcp-warn { border-left: 4px solid currentColor; padding: 0.4em 0.8em; opacity: 0.9; }
.mcp .mcp-box { border: 1px solid currentColor; border-radius: 4px; padding: 0.4em 1em; margin: 0.8em 0; }
.mcp table.mcp-facts { width: 100%; border-collapse: collapse; margin: 0; }
.mcp table.mcp-facts td { padding: 0.25em 0.6em; vertical-align: top; text-align: left; }
.mcp td.mcp-label { width: 14em; font-weight: bold; white-space: nowrap; }
.mcp .mcp-hint { opacity: 0.75; font-size: 0.92em; }
.mcp .mcp-commits { margin: 0.3em 0 0.6em 1.4em; padding: 0; font-family: monospace; }
.mcp .mcp-pre { white-space: pre-wrap; word-break: break-word; font-family: monospace; font-size: 0.92em;
  border: 1px solid currentColor; border-radius: 4px; padding: 0.6em; margin: 0.4em 0; }
.mcp .mcp-log { max-height: 36em; min-height: 6em; overflow: auto; }
.mcp .mcp-settings label { display: block; margin: 0.5em 0; }
.mcp .mcp-settings input[type=text] { display: block; width: 100%; max-width: 40em; margin-top: 0.2em; }
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/mcpanel/mcpanel.js" Mode="0644">
<INLINE>
<![CDATA[
/* MCPanel plugin page. Every request is a POST to include/action.php ($.post of the Unraid web UI adds the
 * CSRF token). Text from the server is put in with textContent only. NOT RUN ON A REAL UNRAID HOST YET. */
(function () {
  'use strict';
  var URL = '/plugins/mcpanel/include/action.php';
  var facts = {};
  var view = { name: '', offset: 0, follow: false };
  var poller = null;
  var pending = null; // {task, option} waiting for the confirmation

  function $id(id) { return document.getElementById(id); }
  function show(node, yes) { node.classList.toggle('mcp-hidden', !yes); }
  function post(data) {
    return $.post(URL, data).then(function (r) { return typeof r === 'string' ? JSON.parse(r) : r; });
  }
  function when(epoch) {
    var n = parseInt(epoch, 10);
    return n > 0 ? new Date(n * 1000).toLocaleString() : '';
  }
  function newer(a, b) { return !!a && !!b && a > b; } // plugin versions compare as strings, as Unraid does

  function row(label, value, hint) {
    var tr = document.createElement('tr');
    var th = document.createElement('td');
    var td = document.createElement('td');
    th.className = 'mcp-label';
    th.textContent = label;
    td.textContent = value;
    if (hint) {
      var p = document.createElement('div');
      p.className = 'mcp-hint';
      p.textContent = hint;
      td.appendChild(p);
    }
    tr.appendChild(th);
    tr.appendChild(td);
    return tr;
  }

  function panelAddress(published) {
    // "0.0.0.0:8080", "[::]:8080", "127.0.0.1:8080" or "<address>:8080"
    var m = /^(.*):(\d+)$/.exec(published || '');
    if (!m) return null;
    var host = m[1];
    if (host === '127.0.0.1' || host === '[::1]') return { local: true, text: published };
    if (host === '0.0.0.0' || host === '[::]' || host === '') host = location.hostname;
    return { local: false, url: 'http://' + host + ':' + m[2] + '/' };
  }

  function render() {
    var f = facts, rows = $id('mcp-facts'), hint;
    rows.textContent = '';
    hint = '';
    if (newer(f.CHECKOUT_PLUGIN_VERSION, f.PLUGIN_VERSION) || newer(f.PLUGIN_UPSTREAM, f.PLUGIN_VERSION)) {
      hint = 'A newer version of this plugin exists (' + (f.CHECKOUT_PLUGIN_VERSION > (f.PLUGIN_UPSTREAM || '') ?
        f.CHECKOUT_PLUGIN_VERSION + ' in the checkout' : f.PLUGIN_UPSTREAM + ' upstream') +
        '): update it under Plugins (Check for updates), Unraid\'s normal plugin update.';
    }
    rows.appendChild(row('Plugin', f.PLUGIN_VERSION || '(not installed through the plugin manager)', hint));
    if (f.CHECKOUT) {
      rows.appendChild(row('Checkout', f.CHECKOUT + (f.CHECKOUT_FROM === 'detected' ? ' (found from the running stack)' : ' (settings)'),
        f.CHECKOUT_PROBLEM || ''));
    } else {
      rows.appendChild(row('Checkout', f.CHECKOUT_FROM === 'ambiguous' ? 'Docker knows several MCPanel stacks: set the checkout under Settings' :
        'not found: no running stack to take it from; set it under Settings'));
    }
    if (f.HEAD) {
      rows.appendChild(row('Source tree', f.HEAD + (f.BRANCH ? '  [branch ' + f.BRANCH + (f.DETACHED === '1' ? ', detached after a rollback' : '') + ']' : ''),
        f.LOCAL_CHANGES && f.LOCAL_CHANGES !== '0' ? 'Local changes in ' + f.LOCAL_CHANGES + ' file(s): Update refuses until they are committed or undone.' : ''));
    }
    rows.appendChild(row('Compose project', (f.PROJECT || '') + ' (' + ({ settings: 'settings', detected: 'found from the running stack', 'default': 'default' }[f.PROJECT_FROM] || '') + ')'));
    var notes = [];
    if (f.COMPOSE_LINK) notes.push('Linked: ' + f.COMPOSE_LINK + '.');
    if (f.LOOSE_DIRS) notes.push('Writable by group or others (mode, path): ' + f.LOOSE_DIRS + '; the boot tasks and Install Compose tighten them.');
    if (f.COMPOSE && f.COMPOSE_LINK && !f.SET_COMPOSE_BIN && !f.REMEMBERED_COMPOSE_BIN && f.OWN_COMPOSE !== 'installed') {
      notes.push('Nothing links it again after a reboot (the link is in RAM): enter that binary under Settings, or Install Compose.');
    }
    rows.appendChild(row('Docker Compose', f.COMPOSE || 'does not answer ("docker compose version")', notes.join(' ')));
    rows.appendChild(row('Shutdown hook', f.HOOK === 'installed' ? 'installed' : 'not installed (the boot tasks install it: at every Docker start, or Boot tasks > Run now)'));
    hint = '';
    if (f.BOOT_RESULT) hint = 'Last run: ' + f.BOOT_RESULT + (f.BOOT_ENDED ? ' at ' + when(f.BOOT_ENDED) : '') + ' (log ' + (f.BOOT_LOG || '').replace(/^.*\//, '') + ')';
    if (f.BOOT_NEEDS) hint += (hint ? '. ' : '') + 'NEEDS YOU: ' + f.BOOT_NEEDS;
    rows.appendChild(row('Boot tasks', f.BOOT_EVENT === 'yes' ? 'run at every Docker start' : 'the event script is missing: reinstall the plugin', hint));
    if (f.RUN_DIR_PROBLEM) rows.appendChild(row('Run folder', f.RUN_DIR_PROBLEM));
    if ((f.USER_SCRIPT || []).length || f.GO_FILE === 'yes') {
      rows.appendChild(row('Also at boot', (f.USER_SCRIPT || []).map(function (s) { return 'User Script "' + s + '"'; })
        .concat(f.GO_FILE === 'yes' ? ['/boot/config/go'] : []).join(', '),
        'It runs array-start.sh or install-hook.sh as well. The plugin does that now: take it out (both at once do no harm; they wait for each other).'));
    }
    var panel = panelAddress(f.PANEL_PUBLISHED), open = $id('mcp-open');
    if (panel && !panel.local) {
      open.href = panel.url;
      rows.appendChild(row('Panel', panel.url));
    } else if (panel) {
      rows.appendChild(row('Panel', 'listens on ' + panel.text + ' only (MCPANEL_BIND): reach it through your reverse proxy or tunnel'));
    } else {
      rows.appendChild(row('Panel', f.CHECKOUT ? 'not running' : ''));
    }
    show(open, !!(panel && !panel.local));
    var busy = f.BUSY === '1';
    if (busy) {
      rows.appendChild(row('Action', 'running: ' + (f.TASK_TASK || '') + (f.TASK_OPTION ? ' ' + f.TASK_OPTION : '') + ' since ' + when(f.TASK_STARTED)));
    } else if (f.TASK_TASK) {
      var result = f.TASK_RESULT === 'running' ? 'interrupted (its process is gone; the log shows how far it got)' : f.TASK_RESULT + (f.TASK_EXIT && f.TASK_EXIT !== '0' ? ' (exit ' + f.TASK_EXIT + ')' : '');
      rows.appendChild(row('Last action', (f.TASK_TASK || '') + (f.TASK_OPTION ? ' ' + f.TASK_OPTION : '') + ': ' + result + (f.TASK_ENDED ? ' at ' + when(f.TASK_ENDED) : ''),
        f.TASK_NEEDS ? 'NEEDS YOU: ' + f.TASK_NEEDS : ''));
    }

    // update
    var info = [];
    if (f.UPSTREAM) {
      info.push(f.BEHIND === undefined ? 'Upstream ' + f.UPSTREAM + ': not fetched yet (Check for updates).' :
        f.BEHIND + ' commit(s) behind ' + f.UPSTREAM + (f.AHEAD && f.AHEAD !== '0' ? ', ' + f.AHEAD + ' ahead (Update cannot fast-forward then: that is for the terminal)' : '') +
        (f.UPDATES_CHECKED ? ' (checked ' + when(f.UPDATES_CHECKED) + ')' : ' (not checked from this page yet)') + '.');
    }
    if (f.GIT === 'no') info.push('This checkout has no .git folder (a ZIP download): Check for updates, Update and Roll back need a git clone (docs/UNRAID.md, section 3). The boot tasks work without it.');
    $id('mcp-update-info').textContent = info.join(' ');
    var list = $id('mcp-commits');
    list.textContent = '';
    (f.UPDATE_COMMIT || []).forEach(function (c) {
      var li = document.createElement('li');
      li.textContent = c;
      list.appendChild(li);
    });
    show($id('mcp-update-run'), !busy && (f.PLAN_UPDATE === 'run' || f.PLAN_UPDATE === 'run-with-migrations'));
    show($id('mcp-migrations-row'), f.PLAN_UPDATE === 'run-with-migrations');
    show($id('mcp-rollback-run'), !busy && (f.PLAN_ROLLBACK === 'rollback' || f.PLAN_ROLLBACK === 'rollback-archive'));
    show($id('mcp-archive-row'), f.PLAN_ROLLBACK === 'rollback-archive');

    // compose
    $id('mcp-compose-info').textContent = 'The plugin\'s copy: Docker Compose ' + f.OWN_COMPOSE_VERSION + ', the official release, checked against SHA-256 ' +
      f.OWN_COMPOSE_SHA256 + ': ' + ({ installed: 'installed on the flash drive', damaged: 'on the flash drive but with ANOTHER checksum: not used, install it again', none: 'not installed' }[f.OWN_COMPOSE] || '') +
      '. A binary set under Settings is preferred while it exists.';

    // settings (not while the owner edits them)
    if (!document.activeElement || !document.activeElement.closest || !document.activeElement.closest('#mcp-settings')) {
      $id('mcp-checkout').value = f.SET_CHECKOUT || '';
      $id('mcp-project').value = f.SET_PROJECT || '';
      $id('mcp-compose-bin').value = f.SET_COMPOSE_BIN || '';
    }

    // logs
    var select = $id('mcp-logs'), keep = view.name || select.value;
    select.textContent = '';
    (f.LOG_FILE || []).forEach(function (name) {
      var o = document.createElement('option');
      o.value = name;
      o.textContent = name;
      select.appendChild(o);
    });
    if (keep) select.value = keep;

    document.querySelectorAll('#mcp input[type=button], #mcp input[type=submit]').forEach(function (b) {
      if (b.id !== 'mcp-confirm-cancel') b.disabled = busy && b.id !== 'mcp-detect';
    });
    syncCheckboxes();
  }

  function syncCheckboxes() {
    $id('mcp-run-upgrade').disabled = facts.BUSY === '1' || (facts.PLAN_UPDATE === 'run-with-migrations' && !$id('mcp-migrations').checked);
    $id('mcp-run-rollback').disabled = facts.BUSY === '1' || (facts.PLAN_ROLLBACK === 'rollback-archive' && !$id('mcp-archive').checked);
  }

  function refresh() {
    return post({ action: 'facts' }).then(function (r) {
      facts = r.facts || {};
      render();
    });
  }

  // --- the log -------------------------------------------------------------------------------------------
  function loadLog(name, follow) {
    view = { name: name, offset: 0, follow: follow };
    $id('mcp-log').textContent = '';
    poll();
  }
  function poll() {
    clearTimeout(poller);
    post({ action: 'log', name: view.name, offset: String(view.offset) }).then(function (r) {
      if (!r.ok) return;
      var pre = $id('mcp-log');
      var bottom = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 20;
      if (r.name && r.name !== view.name) {
        view.name = r.name;
        pre.textContent = '';
      }
      if (r.data) pre.textContent += r.data;
      view.offset = r.offset || 0;
      if (bottom) pre.scrollTop = pre.scrollHeight;
      var t = r.task || {}, running = r.busy && (view.follow || r.current);
      $id('mcp-log-state').textContent = r.name ? (running ? 'running...' : (r.current && t.RESULT ? (t.RESULT === 'running' ? 'interrupted' : t.RESULT) : '')) : 'no log yet';
      if (running || (r.data && r.data.length >= 262144)) {
        poller = setTimeout(poll, 1000);
      } else if (view.follow) {
        view.follow = false;
        refresh();
      }
    });
  }

  // --- tasks ---------------------------------------------------------------------------------------------
  function start(task, option) {
    post({ action: 'start', task: task, option: option || '' }).then(function (r) {
      if (!r.ok) {
        $id('mcp-log-state').textContent = r.text || r.error || 'refused';
        return;
      }
      setTimeout(function () {
        refresh().then(function () { loadLog('', true); });
      }, 300);
    });
  }
  function confirmTask(task, option, title) {
    post({ action: 'describe', task: task, option: option || '' }).then(function (r) {
      pending = r.ok ? { task: task, option: option || '' } : null;
      $id('mcp-confirm-title').textContent = title;
      $id('mcp-confirm-text').textContent = r.text || r.error || '';
      show($id('mcp-confirm-run'), !!pending);
      show($id('mcp-confirm'), true);
      if ($id('mcp-confirm').scrollIntoView) $id('mcp-confirm').scrollIntoView({ block: 'center' });
    });
  }

  document.addEventListener('click', function (e) {
    var b = e.target;
    if (!b || b.tagName !== 'INPUT' || !b.closest('#mcp')) return;
    if (b.dataset.task) start(b.dataset.task, '');
    else if (b.dataset.confirm) confirmTask(b.dataset.confirm, '', b.value.replace(/\.\.\.$/, ''));
    else if (b.id === 'mcp-run-upgrade') confirmTask('update-run', $id('mcp-migrations').checked ? 'with-migrations' : '', 'Run the upgrade');
    else if (b.id === 'mcp-run-rollback') confirmTask('rollback-run', $id('mcp-archive').checked ? 'archive-other-games' : '', 'Roll back now');
    else if (b.id === 'mcp-confirm-cancel') { pending = null; show($id('mcp-confirm'), false); }
    else if (b.id === 'mcp-confirm-run' && pending) { var p = pending; pending = null; show($id('mcp-confirm'), false); start(p.task, p.option); }
    else if (b.id === 'mcp-detect') {
      post({ action: 'detect' }).then(function (r) {
        var found = (r.facts && r.facts.DETECTED) || [];
        if (found.length === 1) {
          $id('mcp-project').value = found[0].split('|')[0];
          $id('mcp-checkout').value = found[0].slice(found[0].indexOf('|') + 1);
        }
        $id('mcp-settings-msg').textContent = found.length === 1 ? 'Found; press Save to keep it.' :
          found.length ? 'Several stacks: ' + found.join(', ') : 'No running MCPanel stack found.';
      });
    }
  });
  document.addEventListener('change', function (e) {
    if (e.target.id === 'mcp-migrations' || e.target.id === 'mcp-archive') syncCheckboxes();
    if (e.target.id === 'mcp-logs') loadLog(e.target.value, false);
  });
  $id('mcp-settings').addEventListener('submit', function (e) {
    e.preventDefault();
    post({ action: 'save', checkout: $id('mcp-checkout').value, project: $id('mcp-project').value, compose_bin: $id('mcp-compose-bin').value })
      .then(function (r) {
        $id('mcp-settings-msg').textContent = r.text || r.error || '';
        refresh();
      });
  });

  refresh().then(function () { loadLog('', facts.BUSY === '1'); });
})();
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/mcpanel/include/common.php" Mode="0644">
<INLINE>
<![CDATA[
<?php
/* MCPanel plugin for Unraid: what the page's endpoint (action.php) does. Every action ends in bin/mcpanel,
 * started without a shell (proc_open with an argument list); the runner checks everything again. Unraid's
 * local_prepend.php has already refused a POST without the right CSRF token before this file runs.
 *
 * NOT RUN ON A REAL UNRAID HOST YET (docs/UNRAID.md, "The Unraid plugin").
 */

const MCPANEL_TASKS = [
    'status' => [''],
    'check-updates' => [''],
    'update-prepare' => [''],
    'update-run' => ['', 'with-migrations'],
    'rollback-prepare' => [''],
    'rollback-run' => ['', 'archive-other-games'],
    'boot-status' => [''],
    'boot-dry-run' => [''],
    'boot-run' => [''],
    'firewall-status' => [''],
    'firewall-dry-run' => [''],
    'firewall-install' => [''],
    'firewall-remove' => [''],
    'compose-install' => [''],
];
const MCPANEL_LOG_CHUNK = 262144;

function mcpanel_config(): array
{
    return [
        'runner' => dirname(__DIR__) . '/bin/mcpanel',
        'run_dir' => '/run/mcpanel',
    ];
}

/* Run the runner with these arguments (no shell). Returns [exit code, standard output + error]. */
function mcpanel_run(array $cfg, array $args): array
{
    umask(022);
    $pipes = [];
    $proc = proc_open(
        array_merge([$cfg['runner']], $args),
        [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes
    );
    if (!is_resource($proc)) {
        return [127, 'could not start ' . $cfg['runner']];
    }
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $rc = proc_close($proc);
    return [$rc, rtrim($out . $err)];
}

/* KEY=value lines of `mcpanel facts` (keys that come more than once become lists). */
function mcpanel_parse_facts(string $text): array
{
    $lists = ['LOG_FILE', 'UPDATE_COMMIT', 'USER_SCRIPT', 'DETECTED'];
    $facts = array_fill_keys($lists, []);
    foreach (explode("\n", $text) as $line) {
        if (!preg_match('/^([A-Z][A-Z_]*)=(.*)$/', $line, $m)) {
            continue;
        }
        if (in_array($m[1], $lists, true)) {
            $facts[$m[1]][] = $m[2];
        } else {
            $facts[$m[1]] = $m[2];
        }
    }
    return $facts;
}

/* A value of the request: a string of at most $max characters without control characters, else null. */
function mcpanel_field(array $post, string $key, int $max = 1024): ?string
{
    $value = $post[$key] ?? '';
    if (!is_string($value) || strlen($value) > $max || preg_match('/[\x00-\x1f\x7f]/', $value)) {
        return null;
    }
    return $value;
}

function mcpanel_task(array $post): ?array
{
    $task = mcpanel_field($post, 'task', 64);
    $option = mcpanel_field($post, 'option', 64);
    if ($task === null || $option === null || !array_key_exists($task, MCPANEL_TASKS)) {
        return null;
    }
    if (!in_array($option, MCPANEL_TASKS[$task], true)) {
        return null;
    }
    return $option === '' ? [$task] : [$task, $option];
}

/* A folder (not a link) of the user this runs as (root on Unraid) that group and others cannot write. */
function mcpanel_own_dir(string $dir): bool
{
    clearstatcache(true, $dir);
    if (!is_dir($dir) || is_link($dir)) {
        return false;
    }
    $uid = function_exists('posix_geteuid') ? posix_geteuid() : 0;
    return fileowner($dir) === $uid && (fileperms($dir) & 0022) === 0;
}

/* The run folder and its logs folder are read only when they are root's own (bin/mcpanel checks the same). */
function mcpanel_run_dir_ok(array $cfg): bool
{
    foreach ([$cfg['run_dir'], $cfg['run_dir'] . '/logs'] as $dir) {
        if ((file_exists($dir) || is_link($dir)) && !mcpanel_own_dir($dir)) {
            return false;
        }
    }
    return true;
}

/* The log of a task: only files the runner wrote (logs/<time>-<task>.log), read from an offset. */
function mcpanel_log(array $cfg, array $post): array
{
    if (!mcpanel_run_dir_ok($cfg)) {
        return ['ok' => false, 'error' => 'the run folder is not root\'s own: the page does not read it'];
    }
    $logs = $cfg['run_dir'] . '/logs';
    $name = mcpanel_field($post, 'name', 128);
    $offset = mcpanel_field($post, 'offset', 12);
    if ($name === null || $offset === null || ($offset !== '' && !ctype_digit($offset))) {
        return ['ok' => false, 'error' => 'bad request'];
    }
    $task = [];
    if (is_file($cfg['run_dir'] . '/task.env') && !is_link($cfg['run_dir'] . '/task.env')) {
        foreach (file($cfg['run_dir'] . '/task.env', FILE_IGNORE_NEW_LINES) as $line) {
            if (preg_match('/^(TASK|OPTION|PID|STARTED|LOG|RESULT|EXIT|ENDED|NEEDS)=(.*)$/', $line, $m)) {
                $task[$m[1]] = $m[2];
            }
        }
    }
    if ($name === '') {
        $name = basename($task['LOG'] ?? '');
    }
    if (!preg_match('/^[0-9]{8}-[0-9]{6}-[a-z-]{2,40}\.log$/', $name)) {
        return ['ok' => true, 'name' => '', 'data' => '', 'offset' => 0, 'busy' => mcpanel_busy($cfg), 'task' => $task];
    }
    $path = "$logs/$name";
    $size = is_file($path) && !is_link($path) ? filesize($path) : 0;
    $from = $offset === '' ? 0 : min((int)$offset, $size);
    $data = '';
    if ($size > $from && ($fh = fopen($path, 'rb'))) {
        fseek($fh, $from);
        $data = fread($fh, MCPANEL_LOG_CHUNK);
        fclose($fh);
    }
    return [
        'ok' => true,
        'name' => $name,
        'data' => $data,
        'offset' => $from + strlen($data),
        'size' => $size,
        'busy' => mcpanel_busy($cfg),
        'current' => basename($task['LOG'] ?? '') === $name,
        'task' => $task,
    ];
}

/* A task runs while its lock is held (the kernel frees it when the task and its children are gone). */
function mcpanel_busy(array $cfg): bool
{
    $lock = $cfg['run_dir'] . '/lock';
    if (!mcpanel_run_dir_ok($cfg) || !is_file($lock) || is_link($lock) || !($fh = @fopen($lock, 'r'))) {
        return false;
    }
    $free = flock($fh, LOCK_SH | LOCK_NB);
    if ($free) {
        flock($fh, LOCK_UN);
    }
    fclose($fh);
    return !$free;
}

function mcpanel_handle(array $post, array $cfg): array
{
    $action = mcpanel_field($post, 'action', 32);
    switch ($action) {
        case 'facts':
            [$rc, $out] = mcpanel_run($cfg, ['facts']);
            return ['ok' => $rc === 0, 'facts' => mcpanel_parse_facts($out)];
        case 'detect':
            [$rc, $out] = mcpanel_run($cfg, ['detect']);
            return ['ok' => $rc === 0, 'facts' => mcpanel_parse_facts($out)];
        case 'describe':
        case 'start':
            $args = mcpanel_task($post);
            if ($args === null) {
                return ['ok' => false, 'error' => 'not a task of this page'];
            }
            [$rc, $out] = mcpanel_run($cfg, array_merge([$action], $args));
            return ['ok' => $rc === 0, 'busy' => $rc === 75, 'text' => $out];
        case 'save':
            $values = [];
            foreach (['checkout', 'project', 'compose_bin'] as $key) {
                $value = mcpanel_field($post, $key);
                if ($value === null) {
                    return ['ok' => false, 'error' => "$key: not a value the settings take"];
                }
                $values[] = trim($value);
            }
            [$rc, $out] = mcpanel_run($cfg, array_merge(['save'], $values));
            return ['ok' => $rc === 0, 'text' => $out];
        case 'log':
            return mcpanel_log($cfg, $post);
    }
    return ['ok' => false, 'error' => 'unknown action'];
}
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/mcpanel/include/action.php" Mode="0644">
<INLINE>
<![CDATA[
<?php
/* MCPanel plugin: the endpoint of the page. POST only: Unraid's local_prepend.php refuses every POST without
 * the session's CSRF token before this runs (jQuery's $.post of the web UI adds it). */
require_once __DIR__ . '/common.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    http_response_code(405);
    echo json_encode(['ok' => false, 'error' => 'POST only']);
    exit;
}
echo json_encode(mcpanel_handle($_POST, mcpanel_config()), JSON_INVALID_UTF8_SUBSTITUTE);
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/mcpanel/bin/mcpanel" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
# MCPanel plugin for Unraid: the one program behind the plugin's page and its event script. Root runs it.
#
#   mcpanel facts                    what the page shows at once (KEY=value lines; no network, changes nothing)
#   mcpanel describe TASK [OPTION]   the exact commands TASK would run now, or why it refuses (changes nothing)
#   mcpanel start TASK [OPTION]      check TASK and OPTION, take the lock, run TASK in the background; what it
#                                    prints goes into a log in /run/mcpanel/logs that the page shows live
#   mcpanel boot                     the boot tasks (event/docker_started starts it in the background): waits
#                                    for a running action, then runs the task boot-run
#   mcpanel detect                   the MCPanel stacks Docker knows: "DETECTED=<project>|<checkout>" lines
#   mcpanel save CHECKOUT PROJECT COMPOSE_BIN
#                                    check and store the settings (an empty value: found automatically / none)
#
# Tasks and their options (nothing else is accepted; every task runs exactly what `describe` prints):
#   status                      upgrade.sh status, array-start.sh status
#   check-updates               git fetch of the checkout's upstream branch (never a pull): commits behind
#   update-prepare              git pull --ff-only of a clean checkout, then upgrade.sh dry-run
#   update-run [with-migrations]
#                               upgrade.sh run, only what the dry run of update-prepare proposed for the
#                               same checkout revision (--with-migrations only when it asked for it)
#   rollback-prepare            upgrade.sh rollback --dry-run
#   rollback-run [archive-other-games]
#                               upgrade.sh rollback, only what that dry run proposed
#   boot-status, boot-dry-run   array-start.sh status / dry-run with the plugin's settings
#   boot-run                    what runs at every Docker start: the plugin's Compose (when no binary is set),
#                               then array-start.sh run (Compose link, shutdown hook, firewall, stack check)
#   firewall-status, firewall-dry-run, firewall-install, firewall-remove
#                               instance-firewall.sh status / dry-run / install / remove
#   compose-install             download the pinned Docker Compose release, check its SHA-256, keep it on
#                               the flash drive, put it into Docker's CLI plugin folder
#
# One action at a time: a lock (flock, held by the running task and everything it started; the kernel
# lets it go when they are gone, so a killed task never leaves the page stuck). Everything runs with
# umask 022. The settings file is read line by line, never sourced. The run folder (lock, task state,
# plans, logs) is /run/mcpanel: under /run, which only root can write, and every use checks that it is a
# folder of root's that only root can write; new files are made with noclobber.
#
# ***************************************************************************************************
# NOT RUN ON A REAL UNRAID HOST YET. Tested against stand-ins (docs/UNRAID.md, "The Unraid plugin", has
# the first-run checklist).
# ***************************************************************************************************
#
# MCPANEL_PLUGIN_ROOT (a folder that stands for /) is for tests only; leave it unset on Unraid.
set -u
umask 022
PATH="${PATH:+${PATH}:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# git never asks for a password here (nobody would see the question)
GIT_TERMINAL_PROMPT=0
export PATH GIT_TERMINAL_PROMPT

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
R="${MCPANEL_PLUGIN_ROOT:-}"
CFG_DIR="${R}/boot/config/plugins/mcpanel"
CFG="${CFG_DIR}/mcpanel.cfg"
PLG="${R}/boot/config/plugins/mcpanel.plg"
RUN_DIR="${R}/run/mcpanel"
LOGS="${RUN_DIR}/logs"
LOCK="${RUN_DIR}/lock"
TASK_FILE="${RUN_DIR}/task.env"
BOOT_FILE="${RUN_DIR}/boot.env"
UPDATES_FILE="${RUN_DIR}/updates.env"
LIB_DIR="${R}/usr/local/lib/mcpanel"
CLI_DIR="${R}/usr/local/lib/docker/cli-plugins"
USER_SCRIPTS="${R}/boot/config/plugins/user.scripts/scripts"
GO_FILE="${R}/boot/config/go"
KEEP_LOGS=10
LOGS_MAX_KB=32768 # /run is a small tmpfs (128 MB on Unraid 7.3): the logs together stay below 32 MB
PLAN_HOURS=12

# Docker Compose: the official release, pinned (docs/UNRAID.md, "Compose on Unraid")
COMPOSE_VERSION=v5.7.0
COMPOSE_SHA256=7758048ad38e580f22559603312874fec8bb638d021a9e64182385fc17cc12a2
COMPOSE_URL="https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-x86_64"
COMPOSE_STORE="${CFG_DIR}/docker-compose-${COMPOSE_VERSION}"
COMPOSE_RAM="${LIB_DIR}/docker-compose"

TASKS="status check-updates update-prepare update-run rollback-prepare rollback-run boot-status boot-dry-run boot-run firewall-status firewall-dry-run firewall-install firewall-remove compose-install"
# git runs as root in the checkout: no fsmonitor command and no hooks (as upgrade.sh does)
GIT_SAFE=(-c core.fsmonitor= -c core.hooksPath=/dev/null)

DESCRIBE=0       # 1: x() prints the commands instead of running them
SHOWN=""         # what x() puts in front of a command it only prints
CHECKOUT_SET=""  # the settings (mcpanel.cfg)
PROJECT_SET=""
COMPOSE_BIN_SET=""
CHECKOUT=""      # what is used: the settings, else found from the running stack
CHECKOUT_FROM=""
PROJECT=""
PROJECT_FROM=""
DEPLOY=""
UNRAID=""

say() { printf '%s\n' "$*"; }
fail() { # fail MESSAGE: refuse and end (exit 1)
    say "REFUSED: $*"
    exit 1
}
refused() { # refused MESSAGE: the task does not go on (return 1 from the task)
    say "REFUSED: $*"
    return 1
}
usage() {
    say "usage: mcpanel {facts|detect|boot|describe TASK [OPTION]|start TASK [OPTION]|save CHECKOUT PROJECT COMPOSE_BIN}"
    say "tasks: ${TASKS}"
    exit 64
}
need_root() { [ "$(id -u)" -eq 0 ] || fail "run this as root (the Unraid web UI and terminal are root)"; }
kv() { # kv KEY VALUE: one line of facts (a value never spans lines)
    local value="${2//$'\n'/ }"
    printf '%s=%s\n' "$1" "${value//$'\r'/}"
}

# --- checks of what comes in ------------------------------------------------------------------------
valid_task() { case " ${TASKS} " in *" ${1:-none} "*) return 0 ;; esac; return 1; }
valid_option() { # valid_option TASK OPTION: the one option some tasks take, or none
    case "$1:$2" in
        *:) return 0 ;;
        update-run:with-migrations | rollback-run:archive-other-games) return 0 ;;
    esac
    return 1
}
valid_project() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; }
valid_path() { # absolute, one line, nothing the settings file or a shell line could take for something else
    [[ "$1" == /* ]] && [ "${#1}" -le 1024 ] || return 1
    case "$1" in *[[:cntrl:]]* | *'"'* | *'$'* | *'`'* | *\\* | */../* | */.. | */./* | */.) return 1 ;; esac
    return 0
}

# --- the settings -----------------------------------------------------------------------------------
read_cfg() {
    local line re='^(CHECKOUT|PROJECT|COMPOSE_BIN)="([^"]*)"$'
    [ -f "${CFG}" ] || return 0
    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line%$'\r'}"
        [[ "${line}" =~ ${re} ]] || continue
        case "${BASH_REMATCH[1]}" in
            CHECKOUT) CHECKOUT_SET="${BASH_REMATCH[2]}" ;;
            PROJECT) PROJECT_SET="${BASH_REMATCH[2]}" ;;
            COMPOSE_BIN) COMPOSE_BIN_SET="${BASH_REMATCH[2]}" ;;
        esac
    done <"${CFG}"
    # a value that `save` would not take counts as not set
    valid_path "${CHECKOUT_SET}" || CHECKOUT_SET=""
    valid_project "${PROJECT_SET}" || PROJECT_SET=""
    valid_path "${COMPOSE_BIN_SET}" || COMPOSE_BIN_SET=""
}

# Lines "<project>|<checkout>": panel containers of a Compose project whose working folder is the deploy/
# folder of an MCPanel checkout (Compose's own labels).
detect_lines() {
    local line project wd
    while IFS= read -r line; do
        project="${line%%|*}"
        wd="${line#*|}"
        valid_project "${project}" && valid_path "${wd}" && [ "${wd##*/}" = deploy ] || continue
        [ -f "${wd}/scripts/upgrade.sh" ] && [ -f "${wd}/unraid/array-start.sh" ] || continue
        printf '%s|%s\n' "${project}" "${wd%/deploy}"
    done < <(timeout 10 docker ps -a --filter label=com.docker.compose.service=panel \
        --format '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null) |
        sort -u
}

resolve() {
    local found line
    read_cfg
    found="$(detect_lines)"
    if [ -n "${CHECKOUT_SET}" ]; then
        CHECKOUT="${CHECKOUT_SET}"
        CHECKOUT_FROM=settings
    elif [ -n "${found}" ] && [ "$(printf '%s\n' "${found}" | wc -l)" -eq 1 ]; then
        CHECKOUT="${found#*|}"
        CHECKOUT_FROM=detected
    elif [ -n "${found}" ]; then
        CHECKOUT_FROM=ambiguous
    else
        CHECKOUT_FROM=none
    fi
    if [ -n "${PROJECT_SET}" ]; then
        PROJECT="${PROJECT_SET}"
        PROJECT_FROM=settings
    else
        PROJECT=mcpanel
        PROJECT_FROM=default
        while IFS= read -r line; do
            [ -n "${line}" ] && [ -n "${CHECKOUT}" ] && [ "${line#*|}" = "${CHECKOUT}" ] || continue
            PROJECT="${line%%|*}"
            PROJECT_FROM=detected
        done <<<"${found}"
    fi
    if [ -n "${CHECKOUT}" ]; then
        DEPLOY="${CHECKOUT}/deploy"
        UNRAID="${DEPLOY}/unraid"
    fi
}

# checkout_problem DIR [strict] [git]: why DIR cannot be used (nothing when it can). A checkout without .git (the
# quick start's ZIP download) is fine for everything but the tasks that need git (git). strict: also the rule
# of the scripts that root runs from it (upgrade.sh, install-hook.sh, ...), plus the owner: nothing they run
# or git reads may be writable by group or others or belong to anyone but root.
checkout_problem() {
    local c="$1" f found repair
    local -a paths
    [ -d "${c}" ] || {
        say "${c} is not a folder (is its pool mounted?)"
        return
    }
    for f in deploy/scripts/upgrade.sh deploy/unraid/array-start.sh deploy/unraid/install-hook.sh \
        deploy/unraid/instance-firewall.sh deploy/unraid/stopping_docker deploy/docker-compose.yml; do
        [ -f "${c}/${f}" ] || {
            say "${c} is not an MCPanel checkout (or one from before these scripts): ${f} is missing"
            return
        }
    done
    case " $* " in *" git "*)
        [ -d "${c}/.git" ] || {
            say "${c} has no .git folder (a ZIP download?): this needs a git clone of MCPanel (docs/UNRAID.md, section 3)"
            return
        }
        ;;
    esac
    case " $* " in *" strict "*) ;; *) return 0 ;; esac
    paths=("${c}" "${c}/deploy" "${c}/deploy/scripts" "${c}/deploy/unraid" "${c}/deploy/scripts/upgrade.sh"
        "${c}/deploy/unraid/array-start.sh" "${c}/deploy/unraid/install-hook.sh" "${c}/deploy/unraid/instance-firewall.sh"
        "${c}/deploy/unraid/stopping_docker")
    [ ! -d "${c}/.git" ] || paths+=("${c}/.git" "${c}/.git/config" "${c}/.git/hooks")
    found="$(find -L "${paths[@]}" -maxdepth 0 \( -perm /022 -o ! -uid "${EUID}" \) -printf '%m %u %p, ' 2>/dev/null)"
    [ -n "${found}" ] || return 0
    printf -v repair 'chown -R root:root %q && chmod -R go-w %q' "${c}" "${c}"
    say "group or others can write, or another user than root owns, what root runs or git reads there (mode, owner, path): ${found%, }. Repair it in the Unraid terminal, then try again: ${repair}"
}

need_checkout() { # need_checkout [strict] [git]
    local why
    case "${CHECKOUT_FROM}" in
        none) refused "no MCPanel checkout is known: set its folder under Settings below (no running stack was found to take it from)" || return 1 ;;
        ambiguous) refused "Docker knows several MCPanel stacks: set the checkout under Settings below" || return 1 ;;
    esac
    why="$(checkout_problem "${CHECKOUT}" "$@")"
    [ -z "${why}" ] || refused "${why}"
}

NEEDS=""
needs_you() { # needs_you MESSAGE: something only the owner can do; on the page (the task file) and in the syslog
    say "NEEDS YOU: $*"
    NEEDS="${NEEDS:+${NEEDS} / }$*"
    logger -t mcpanel -- "plugin: ${TASK:-boot-run}: NEEDS YOU: $*" 2>/dev/null || true
}

# --- running and showing commands -------------------------------------------------------------------
# x DIR COMMAND...: show the command as a shell line and run it in DIR ("-": where we are). In a
# description (DESCRIBE=1) only show it.
x() {
    local dir="$1" line
    shift
    printf -v line '%q ' "$@"
    line="${line% }"
    [ "${dir}" = - ] || line="cd $(printf '%q' "${dir}") && ${line}"
    if [ "${DESCRIBE}" = 1 ]; then
        say "${SHOWN}${line}"
        return 0
    fi
    say "\$ ${line}"
    if [ "${dir}" = - ]; then "$@"; else (cd "${dir}" && "$@"); fi
}
gitc() { git -C "${CHECKOUT}" "${GIT_SAFE[@]}" "$@"; }

# --- state files (KEY=value lines; read with a pattern, never sourced) -----------------------------
file_value() { # file_value FILE KEY -> the first value
    [ -f "$1" ] || return 1
    sed -n "s/^$2=//p" "$1" | head -n 1 | tr -d '\r'
}
write_file() { # write_file FILE LINES...: replace FILE at once (a new file, made with noclobber)
    rm -f -- "$1.new" && (
        set -o noclobber
        printf '%s\n' "${@:2}" >"$1.new"
    ) && mv -f -- "$1.new" "$1"
}
state_value() { # a value of deploy/upgrade-state.env (written by upgrade.sh)
    file_value "${DEPLOY}/upgrade-state.env" "$1"
}
state_sum() {
    if [ -f "${DEPLOY}/upgrade-state.env" ]; then sha256sum "${DEPLOY}/upgrade-state.env" | cut -d' ' -f1; else say none; fi
}
plg_version() { # the version attribute of a .plg file
    [ -f "$1" ] || return 0
    sed -n 's/.*<PLUGIN [^>]*version="\([0-9A-Za-z.]*\)".*/\1/p' "$1" | head -n 1
}

own_dir() { # own_dir DIR: a folder (not a link) of this user (root) that group and others cannot write
    [ -d "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] && [ -z "$(find "$1" -maxdepth 0 -perm /022 2>/dev/null)" ]
}
# run_dir_ok: the run folder and its logs folder, where they exist, are root's own (every reader asks this)
run_dir_ok() {
    [ ! -e "${RUN_DIR}" ] && [ ! -L "${RUN_DIR}" ] && return 0
    own_dir "${RUN_DIR}" || return 1
    [ ! -e "${LOGS}" ] && [ ! -L "${LOGS}" ] && return 0
    own_dir "${LOGS}"
}
RUN_DIR_PROBLEM="${RUN_DIR} (or its logs folder) is not a folder of root's that only root can write: the plugin does not use it. Move it away; the plugin makes it again"
ensure_run_dir() {
    run_dir_ok || fail "${RUN_DIR_PROBLEM}"
    mkdir -p "${LOGS}" || fail "could not create ${LOGS}" # (umask 022: mode 755)
    run_dir_ok || fail "${RUN_DIR_PROBLEM}"
}

busy() { # the lock is held (a task runs)
    run_dir_ok && [ -f "${LOCK}" ] && [ ! -L "${LOCK}" ] || return 1
    {
        exec 7>>"${LOCK}"
    } 2>/dev/null || return 1
    if flock -n 7; then
        flock -u 7
        exec 7>&-
        return 1
    fi
    exec 7>&-
    return 0
}

task_line() { # "<task> [option] (pid N, since <time>)" of the task file
    local task option pid started
    task="$(file_value "${TASK_FILE}" TASK)" || task=""
    option="$(file_value "${TASK_FILE}" OPTION)" || option=""
    pid="$(file_value "${TASK_FILE}" PID)" || pid=""
    started="$(file_value "${TASK_FILE}" STARTED)" || started=""
    printf '%s%s (pid %s, since %s)' "${task:-?}" "${option:+ ${option}}" "${pid:-?}" \
        "$(date -d "@${started:-0}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?')"
}

rotate_logs() { # room for one more log: the newest KEEP_LOGS - 1 stay, together below LOGS_MAX_KB
    local name kb count=0 total=0
    # names begin with the time: the newest first
    while IFS='|' read -r name kb; do
        [ -n "${name}" ] || continue
        count=$((count + 1))
        total=$((total + kb))
        if [ "${count}" -ge "${KEEP_LOGS}" ] || [ "${total}" -gt "${LOGS_MAX_KB}" ]; then rm -f -- "${LOGS}/${name}"; fi
    done < <(find "${LOGS}" -maxdepth 1 -type f -name '*.log' -printf '%f|%k\n' 2>/dev/null | sort -r)
}

new_log() { # new_log TASK -> the path of a new, empty log (made with noclobber)
    local log
    while :; do
        log="${LOGS}/$(date +%Y%m%d-%H%M%S)-$1.log"
        if (
            set -o noclobber
            : >"${log}"
        ) 2>/dev/null; then break; fi
        [ -e "${log}" ] || return 1
        sleep 1
    done
    printf '%s' "${log}"
}

# --- Compose ----------------------------------------------------------------------------------------
compose_answers() { timeout 20 docker compose version >/dev/null 2>&1; }
compose_usable() { [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ]; }
own_compose_ok() { # the plugin's copy on the flash drive is there and has the pinned SHA-256
    [ -f "${COMPOSE_STORE}" ] && [ "$(sha256sum "${COMPOSE_STORE}" 2>/dev/null | cut -d' ' -f1)" = "${COMPOSE_SHA256}" ]
}

# Folders whose programs root runs: never writable by group or others (on a server where root's umask is
# 000 a hand-made /usr/local/lib/docker is 777; a sticky folder such as /tmp is left alone).
tighten_dirs() {
    local d
    for d in "${CLI_DIR%/*}" "${CLI_DIR}" "${LIB_DIR}"; do
        [ -d "${d}" ] && [ ! -L "${d}" ] || continue
        [ -n "$(find "${d}" -maxdepth 0 -perm /022 ! -perm -1000 2>/dev/null)" ] || continue
        [ "${DESCRIBE}" = 1 ] || say "${d} is writable by group or others (mode $(stat -c %a "${d}")): root runs what is in it"
        x - chmod go-w "${d}" || return 1
    done
}

# The plugin's own Compose: the copy on the flash drive (checked against the pin) into RAM, and linked into
# Docker's CLI plugin folder unless `docker compose` answers with another binary already.
link_own_compose() {
    if [ "${DESCRIBE}" = 1 ]; then
        say "${SHOWN}(check) sha256sum ${COMPOSE_STORE} = ${COMPOSE_SHA256}"
    elif ! own_compose_ok; then
        needs_you "the plugin's Compose on the flash drive (${COMPOSE_STORE}) is missing or does not have the pinned SHA-256 (damaged or replaced): not used. Install Compose again."
        return 1
    fi
    if [ "${DESCRIBE}" = 1 ] || [ ! -x "${COMPOSE_RAM}" ] || [ -L "${COMPOSE_RAM}" ] ||
        [ "$(sha256sum "${COMPOSE_RAM}" 2>/dev/null | cut -d' ' -f1)" != "${COMPOSE_SHA256}" ]; then
        # the copy in RAM is what root runs: it is checked itself, before it is moved into place
        x - mkdir -p "${LIB_DIR}" && x - rm -f "${COMPOSE_RAM}.new" &&
            x - cp "${COMPOSE_STORE}" "${COMPOSE_RAM}.new" || return 1
        if [ "${DESCRIBE}" = 1 ]; then
            say "${SHOWN}(check) sha256sum ${COMPOSE_RAM}.new = ${COMPOSE_SHA256}"
        elif [ "$(sha256sum "${COMPOSE_RAM}.new" 2>/dev/null | cut -d' ' -f1)" != "${COMPOSE_SHA256}" ]; then
            rm -f "${COMPOSE_RAM}.new"
            needs_you "the copy of the plugin's Compose in ${LIB_DIR} does not have the pinned SHA-256: not used"
            return 1
        fi
        x - chmod 755 "${COMPOSE_RAM}.new" && x - mv -f "${COMPOSE_RAM}.new" "${COMPOSE_RAM}" || return 1
    fi
    if [ "${DESCRIBE}" = 0 ] && compose_answers && [ "$(readlink "${CLI_DIR}/docker-compose")" != "${COMPOSE_RAM}" ]; then
        say "Compose: 'docker compose' answers already ($(readlink -f "${CLI_DIR}/docker-compose" 2>/dev/null || say 'built in')): the plugin's copy stays a fallback and is not linked"
        return 0
    fi
    x - mkdir -p "${CLI_DIR}" && tighten_dirs && x - ln -sfn "${COMPOSE_RAM}" "${CLI_DIR}/docker-compose" || return 1
    [ "${DESCRIBE}" = 1 ] || say "Compose: $(timeout 20 docker compose version 2>/dev/null | head -n 1 || say 'does not answer')"
}

# BOOT_ARGS: what array-start.sh gets besides --project. The Compose binary of the settings when it is there;
# otherwise the plugin's own copy is linked here (when it was installed).
boot_compose() {
    BOOT_ARGS=()
    if compose_usable "${COMPOSE_BIN_SET}"; then
        BOOT_ARGS=(--compose-bin "${COMPOSE_BIN_SET}")
        return 0
    fi
    [ -z "${COMPOSE_BIN_SET}" ] ||
        say "Compose: the binary of the settings (${COMPOSE_BIN_SET}) is missing or not executable (is its pool mounted?)"
    if [ -f "${COMPOSE_STORE}" ]; then
        link_own_compose
        return $?
    fi
    return 0
}

# --- git: the branch and its upstream ----------------------------------------------------------------
# BRANCH, REMOTE, UPSTREAM (refs/remotes/<remote>/<branch>), DETACHED (1: HEAD is detached after a rollback
# of upgrade.sh, which recorded the branch; update-prepare checks it out again first)
branch_info() {
    local merge status
    DETACHED=0
    if ! BRANCH="$(gitc symbolic-ref -q --short HEAD 2>/dev/null)"; then
        status="$(state_value STATUS)" || status=""
        BRANCH="$(state_value BRANCH)" || BRANCH=""
        if [ "${status}" != rolled-back ] || [ -z "${BRANCH}" ]; then
            refused "the checkout is not on a branch (detached HEAD) and upgrade.sh did not record a rollback with its branch: in the Unraid terminal, git -C $(printf '%q' "${CHECKOUT}") checkout <branch>"
            return 1
        fi
        DETACHED=1
    fi
    gitc check-ref-format --branch "${BRANCH}" >/dev/null 2>&1 || {
        refused "not a branch name: ${BRANCH}"
        return 1
    }
    REMOTE="$(gitc config --get "branch.${BRANCH}.remote" 2>/dev/null)" || REMOTE=""
    merge="$(gitc config --get "branch.${BRANCH}.merge" 2>/dev/null)" || merge=""
    if ! [[ "${REMOTE}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || [[ "${merge}" != refs/heads/* ]]; then
        refused "the branch ${BRANCH} has no upstream branch (git branch --set-upstream-to): there is nothing to compare with"
        return 1
    fi
    REMOTE_BRANCH="${merge#refs/heads/}"
    gitc check-ref-format --branch "${REMOTE_BRANCH}" >/dev/null 2>&1 || {
        refused "not a branch name: ${REMOTE_BRANCH}"
        return 1
    }
    UPSTREAM="refs/remotes/${REMOTE}/${REMOTE_BRANCH}"
}

local_changes() { gitc status --porcelain --untracked-files=no 2>/dev/null; }

# --- the dry runs of upgrade.sh and what they propose ---------------------------------------------------
# Both dry runs end with "Nothing was changed. To do it: <command>". The page runs that command only when it
# is one of these; anything else (a repair first, --from, --resume) is for the terminal.
plan_from_dry_run() { # plan_from_dry_run update|rollback
    local kind="$1" out proposed offer=none rc
    local -a dry=(dry-run)
    [ "${kind}" = update ] || dry=(rollback --dry-run)
    if [ "${DESCRIBE}" = 1 ]; then
        x "${DEPLOY}" bash scripts/upgrade.sh "${dry[@]}"
        return 0
    fi
    out="${RUN_DIR}/dry-run.out"
    rm -f "${out}"
    x "${DEPLOY}" bash scripts/upgrade.sh "${dry[@]}" 2>&1 | tee "${out}"
    rc="${PIPESTATUS[0]}"
    proposed="$(sed -n 's/^Nothing was changed\. To do it: //p' "${out}" | tail -n 1)"
    rm -f "${out}"
    case "${kind}:${proposed}" in
        "update:./scripts/upgrade.sh run") offer=run ;;
        "update:./scripts/upgrade.sh run --with-migrations") offer=run-with-migrations ;;
        "rollback:./scripts/upgrade.sh rollback") offer=rollback ;;
        "rollback:./scripts/upgrade.sh rollback --archive-other-games") offer=rollback-archive ;;
    esac
    write_file "${RUN_DIR}/plan-${kind}.env" "HEAD=$(gitc rev-parse HEAD 2>/dev/null)" "STATE=$(state_sum)" \
        "OFFER=${offer}" "MADE=$(date +%s)"
    say ""
    case "${offer}" in
        run) say "The dry run above is what 'Run the upgrade' does now." ;;
        run-with-migrations) say "The dry run above is what 'Run the upgrade' does now. This version changes the database schema: the page asks you to allow the migrations (a rollback undoes them again; data written into new columns is lost then)." ;;
        rollback) say "The dry run above is what 'Roll back now' does." ;;
        rollback-archive) say "The dry run above is what 'Roll back now' does, with --archive-other-games: the servers of other games are stopped through the panel, archived and recorded first." ;;
        none) say "The page offers nothing to run after this dry run${proposed:+ (the script proposes: ${proposed}; that one is for the Unraid terminal, in ${DEPLOY})}." ;;
    esac
    return "${rc}"
}

# plan_offer update|rollback: the offer of the last dry run, when it was made for this checkout revision and
# this upgrade state, within PLAN_HOURS
plan_offer() {
    local file="${RUN_DIR}/plan-$1.env" made
    PLAN_OFFER=""
    run_dir_ok || {
        refused "${RUN_DIR_PROBLEM}"
        return 1
    }
    [ -f "${file}" ] || {
        refused "first the dry run ('$([ "$1" = update ] && printf 'Update' || printf 'Roll back')'): the page runs only what a dry run showed"
        return 1
    }
    made="$(file_value "${file}" MADE)" || made=0
    [[ "${made}" =~ ^[0-9]+$ ]] || made=0
    if [ "$(file_value "${file}" HEAD)" != "$(gitc rev-parse HEAD 2>/dev/null)" ] ||
        [ "$(file_value "${file}" STATE)" != "$(state_sum)" ] || [ $(($(date +%s) - made)) -gt $((PLAN_HOURS * 3600)) ]; then
        refused "the checkout or the upgrade state changed since the dry run (or it is older than ${PLAN_HOURS} hours): do the dry run again"
        return 1
    fi
    PLAN_OFFER="$(file_value "${file}" OFFER)"
}

# --- the tasks ----------------------------------------------------------------------------------------
task_status() {
    local status=0
    need_checkout || return 1
    boot_args_only
    x "${DEPLOY}" bash scripts/upgrade.sh status || status=1
    [ "${DESCRIBE}" = 1 ] || say ""
    x - bash "${UNRAID}/array-start.sh" status --project "${PROJECT}" "${BOOT_ARGS[@]}" || status=1
    return "${status}"
}

boot_args_only() { # BOOT_ARGS without linking anything (status, dry runs)
    BOOT_ARGS=()
    if compose_usable "${COMPOSE_BIN_SET}"; then BOOT_ARGS=(--compose-bin "${COMPOSE_BIN_SET}"); fi
}

task_check_updates() {
    local behind ahead changes plugin_new
    need_checkout strict git || return 1
    branch_info || return 1
    x - timeout 120 git -C "${CHECKOUT}" "${GIT_SAFE[@]}" fetch "${REMOTE}" "${REMOTE_BRANCH}" ||
        refused "git fetch failed (above): no network, or the remote needs a login" || return 1
    if [ "${DESCRIBE}" = 1 ]; then
        x - git -C "${CHECKOUT}" "${GIT_SAFE[@]}" log --format='%h %s' HEAD.."${UPSTREAM}"
        return 0
    fi
    behind="$(gitc rev-list --count "HEAD..${UPSTREAM}" 2>/dev/null)" || behind="?"
    ahead="$(gitc rev-list --count "${UPSTREAM}..HEAD" 2>/dev/null)" || ahead="?"
    changes="$(local_changes | wc -l)"
    plugin_new="$(gitc show "${UPSTREAM}:deploy/unraid/plugin/mcpanel.plg" 2>/dev/null | sed -n 's/.*<PLUGIN [^>]*version="\([0-9A-Za-z.]*\)".*/\1/p' | head -n 1)"
    write_file "${UPDATES_FILE}" "CHECKED=$(date +%s)" "PLUGIN_UPSTREAM=${plugin_new}"
    say ""
    say "Branch ${BRANCH}$([ "${DETACHED}" = 1 ] && printf ' (the checkout is detached after a rollback; Update checks the branch out first)'), upstream ${UPSTREAM#refs/remotes/}"
    say "${behind} commit(s) behind, ${ahead} ahead$([ "${ahead}" != 0 ] && printf ' (git pull --ff-only cannot bring in the upstream commits then: that is for the terminal)')"
    [ "${behind}" = 0 ] || gitc log --format='  %h %s' --max-count=50 "HEAD..${UPSTREAM}"
    if [ "${changes}" != 0 ]; then
        say "The checkout has local changes in ${changes} file(s): Update refuses until they are committed or undone (git -C $(printf '%q' "${CHECKOUT}") status)."
    fi
    if [ -n "${plugin_new}" ] && [[ "${plugin_new}" > "$(plg_version "${PLG}")" ]]; then
        say "The upstream branch has plugin version ${plugin_new} (installed: $(plg_version "${PLG}")): Unraid's Plugins page updates the plugin itself."
    fi
}

task_update_prepare() {
    local changes
    need_checkout strict git || return 1
    branch_info || return 1
    changes="$(local_changes)"
    [ -z "${changes}" ] ||
        refused "the checkout has local changes in $(printf '%s\n' "${changes}" | wc -l) file(s) (git -C $(printf '%q' "${CHECKOUT}") status lists them): Update only fast-forwards a clean checkout. Commit or undo them in the Unraid terminal first." ||
        return 1
    if [ "${DETACHED}" = 1 ]; then
        x - git -C "${CHECKOUT}" "${GIT_SAFE[@]}" checkout "${BRANCH}" || refused "git checkout ${BRANCH} failed (above): nothing was deployed" || return 1
    fi
    x - timeout 300 git -C "${CHECKOUT}" "${GIT_SAFE[@]}" pull --ff-only ||
        refused "git pull --ff-only failed (above): nothing was deployed, the running version is unchanged" || return 1
    [ "${DESCRIBE}" = 1 ] || say ""
    plan_from_dry_run update
}

task_update_run() {
    local -a args=()
    need_checkout strict git || return 1
    plan_offer update || return 1
    case "${PLAN_OFFER}:$1" in
        run:) ;;
        run-with-migrations:with-migrations) args=(--with-migrations) ;;
        run-with-migrations:) refused "this version changes the database schema (the dry run says so): allow the migrations to run it" || return 1 ;;
        run:with-migrations) refused "the dry run did not ask for database migrations: --with-migrations is not given" || return 1 ;;
        *) refused "the dry run proposed nothing the page runs (see its last lines)" || return 1 ;;
    esac
    [ "${DESCRIBE}" = 1 ] || rm -f "${RUN_DIR}/plan-update.env" # one run per dry run
    x "${DEPLOY}" bash scripts/upgrade.sh run "${args[@]}"
}

task_rollback_prepare() {
    need_checkout strict git || return 1
    plan_from_dry_run rollback
}

task_rollback_run() {
    local -a args=()
    need_checkout strict git || return 1
    plan_offer rollback || return 1
    case "${PLAN_OFFER}:$1" in
        rollback:) ;;
        rollback-archive:archive-other-games) args=(--archive-other-games) ;;
        rollback-archive:) refused "the dry run says servers of other games must be archived first: allow that to roll back" || return 1 ;;
        rollback:archive-other-games) refused "the dry run did not ask to archive servers of other games: --archive-other-games is not given" || return 1 ;;
        *) refused "the dry run proposed nothing the page runs (see its last lines)" || return 1 ;;
    esac
    [ "${DESCRIBE}" = 1 ] || rm -f "${RUN_DIR}/plan-rollback.env"
    x "${DEPLOY}" bash scripts/upgrade.sh rollback "${args[@]}"
}

task_boot_status() {
    need_checkout || return 1
    boot_args_only
    x - bash "${UNRAID}/array-start.sh" status --project "${PROJECT}" "${BOOT_ARGS[@]}"
}

task_boot_dry_run() {
    need_checkout || return 1
    if [ "${DESCRIBE}" = 0 ]; then
        say "What 'Run boot tasks' (and every Docker start) would do now; nothing is changed:"
        if ! compose_usable "${COMPOSE_BIN_SET}" && [ -f "${COMPOSE_STORE}" ]; then
            say "The plugin's Compose (no binary is set, or it is missing):"
            DESCRIBE=1 SHOWN="  would run: " link_own_compose
        fi
        DESCRIBE=1 SHOWN="  would run: " tighten_dirs
    fi
    boot_args_only
    x - bash "${UNRAID}/array-start.sh" dry-run --project "${PROJECT}" "${BOOT_ARGS[@]}"
}

task_boot_run() {
    local status=0
    tighten_dirs || status=1
    boot_compose || status=1
    # root runs the checkout's scripts unattended: only when nothing of them is writable by others or owned
    # by anyone but root (this plugin does not repair it: the page and the syslog say what to run)
    local why=""
    case "${CHECKOUT_FROM}" in
        none) why="no MCPanel checkout is known (no settings, and no stack to take it from)" ;;
        ambiguous) why="Docker knows several MCPanel stacks: set the checkout on the plugin's page" ;;
        *) why="$(checkout_problem "${CHECKOUT}" strict)" ;;
    esac
    if [ -n "${why}" ] && [ "${DESCRIBE}" = 1 ]; then
        refused "${why}"
        return 1
    elif [ -n "${why}" ]; then
        needs_you "boot tasks of the checkout NOT run (shutdown hook, firewall, stack check${BOOT_ARGS[0]:+, the Compose link}): ${why}"
        return 1
    fi
    if ! x - bash "${UNRAID}/array-start.sh" run --project "${PROJECT}" "${BOOT_ARGS[@]}"; then
        needs_you "array-start.sh reported something to do (its NEEDS YOU lines above, and the syslog)"
        status=1
    fi
    return "${status}"
}

task_firewall() { # task_firewall status|dry-run|install|remove
    if [ "$1" = install ] || [ "$1" = remove ]; then need_checkout strict || return 1; else need_checkout || return 1; fi
    x - bash "${UNRAID}/instance-firewall.sh" "$1"
}

task_compose_install() {
    # downloaded into the plugin's folder in RAM (root's; /run is too small for 34 MB)
    local tmp="${LIB_DIR}/docker-compose.download" sum
    say "Docker Compose ${COMPOSE_VERSION} (the official release), SHA-256 ${COMPOSE_SHA256}"
    if [ "${DESCRIBE}" = 0 ]; then
        mkdir -p "${LIB_DIR}" && tighten_dirs && own_dir "${LIB_DIR}" ||
            refused "${LIB_DIR} is not a folder of root's that only root can write" || return 1
        rm -f "${tmp}"
    fi
    x - curl -fsSL --proto =https --tlsv1.2 --retry 3 --connect-timeout 20 --max-time 900 -o "${tmp}" "${COMPOSE_URL}" || {
        rm -f "${tmp}"
        refused "the download failed (above): nothing was changed"
        return 1
    }
    if [ "${DESCRIBE}" = 1 ]; then
        say "(check) sha256sum ${tmp} = ${COMPOSE_SHA256}"
    else
        sum="$(sha256sum "${tmp}" | cut -d' ' -f1)"
        say "SHA-256 of the download: ${sum}"
        if [ "${sum}" != "${COMPOSE_SHA256}" ]; then
            rm -f "${tmp}"
            refused "that is not the pinned SHA-256: the download was deleted, nothing was changed"
            return 1
        fi
    fi
    x - mkdir -p "${CFG_DIR}" && x - cp "${tmp}" "${COMPOSE_STORE}.new" ||
        refused "could not keep it on the flash drive (above)" || return 1
    if [ "${DESCRIBE}" = 1 ]; then
        say "(check) sha256sum ${COMPOSE_STORE}.new = ${COMPOSE_SHA256}"
    elif [ "$(sha256sum "${COMPOSE_STORE}.new" 2>/dev/null | cut -d' ' -f1)" != "${COMPOSE_SHA256}" ]; then
        rm -f "${tmp}" "${COMPOSE_STORE}.new"
        refused "the copy on the flash drive does not have the pinned SHA-256 (the flash drive?): nothing was changed"
        return 1
    fi
    x - mv -f "${COMPOSE_STORE}.new" "${COMPOSE_STORE}" && x - rm -f "${tmp}" ||
        refused "could not keep it on the flash drive (above)" || return 1
    link_own_compose
}

run_task() { # run_task TASK OPTION
    case "$1" in
        status) task_status ;;
        check-updates) task_check_updates ;;
        update-prepare) task_update_prepare ;;
        update-run) task_update_run "$2" ;;
        rollback-prepare) task_rollback_prepare ;;
        rollback-run) task_rollback_run "$2" ;;
        boot-status) task_boot_status ;;
        boot-dry-run) task_boot_dry_run ;;
        boot-run) task_boot_run ;;
        firewall-status) task_firewall status ;;
        firewall-dry-run) task_firewall dry-run ;;
        firewall-install) task_firewall install ;;
        firewall-remove) task_firewall remove ;;
        compose-install) task_compose_install ;;
        *) return 64 ;;
    esac
}

# --- commands -------------------------------------------------------------------------------------------
check_args() { # check_args TASK [OPTION]: the task exists, the option is its one option, nothing else
    if ! { [ "$#" -ge 1 ] && [ "$#" -le 2 ] && valid_task "$1" && valid_option "$1" "${2:-}"; }; then
        say "REFUSED: not a task of this plugin, or an option it does not take: $*"
        usage
    fi
}

cmd_describe() {
    check_args "$@"
    need_root
    resolve
    DESCRIBE=1
    say "Runs as root with umask 022, in this order:"
    run_task "$1" "${2:-}"
}

finish_task() { # the EXIT trap of a task
    local rc="$1" result=ok
    [ "${rc}" = 0 ] || result=failed
    say ""
    say "Finished: ${result}$([ "${rc}" = 0 ] || printf ' (exit %s)' "${rc}") at $(date '+%Y-%m-%d %H:%M:%S')"
    write_file "${TASK_FILE}" "TASK=${TASK}" "OPTION=${OPTION}" "PID=$$" "STARTED=${STARTED}" "LOG=${TASK_LOG}" \
        "RESULT=${result}" "EXIT=${rc}" "ENDED=$(date +%s)" "NEEDS=${NEEDS//$'\n'/ }"
    if [ "${TASK}" = boot-run ]; then
        cp -f "${TASK_FILE}" "${BOOT_FILE}" 2>/dev/null
        logger -t mcpanel -- "plugin: boot tasks finished: ${result} (log ${TASK_LOG})" 2>/dev/null || true
    fi
}

# worker TASK OPTION LOG: runs the task (started by `start` or `boot`, which hold the lock and pass it on)
cmd_worker() {
    TASK="$1" OPTION="$2" TASK_LOG="$3" STARTED="$(date +%s)"
    valid_task "${TASK}" && valid_option "${TASK}" "${OPTION}" || exit 64
    write_file "${TASK_FILE}" "TASK=${TASK}" "OPTION=${OPTION}" "PID=$$" "STARTED=${STARTED}" "LOG=${TASK_LOG}" "RESULT=running"
    trap 'finish_task $?' EXIT
    say "MCPanel plugin $(plg_version "${PLG}"): ${TASK}${OPTION:+ ${OPTION}}, started $(date '+%Y-%m-%d %H:%M:%S') (pid $$)"
    say "Everything below runs as root with umask 022."
    say ""
    resolve
    run_task "${TASK}" "${OPTION}"
    exit $?
}

cmd_start() {
    local log
    check_args "$@"
    need_root
    ensure_run_dir
    exec 9>>"${LOCK}" || fail "could not open ${LOCK}"
    if ! flock -n 9; then
        say "BUSY: another action is running: $(task_line)"
        exit 75
    fi
    rotate_logs
    log="$(new_log "$1")" || fail "could not create a log in ${LOGS}"
    write_file "${TASK_FILE}" "TASK=$1" "OPTION=${2:-}" "PID=0" "STARTED=$(date +%s)" "LOG=${log}" "RESULT=running"
    # a session of its own: it outlives the web request; it holds the lock (fd 9) until it and its children end
    # shellcheck disable=SC2094 # the worker gets the log's name for its task file; it does not read it
    setsid "${SELF}" worker "$1" "${2:-}" "${log}" </dev/null >>"${log}" 2>&1 &
    say "STARTED: $1${2:+ $2} (pid $!), log ${log}"
}

cmd_boot() {
    local log
    need_root
    ensure_run_dir
    exec 9>>"${LOCK}" || fail "could not open ${LOCK}"
    if ! flock -n 9; then
        logger -t mcpanel -- "plugin: the boot tasks wait for the running action: $(task_line)" 2>/dev/null || true
        flock -w 3600 9 || {
            logger -t mcpanel -- "plugin: boot tasks NOT run: another action ran for an hour" 2>/dev/null || true
            exit 1
        }
    fi
    rotate_logs
    log="$(new_log boot-run)" || {
        logger -t mcpanel -- "plugin: boot tasks NOT run: could not create a log in ${LOGS}" 2>/dev/null || true
        exit 1
    }
    exec </dev/null >>"${log}" 2>&1
    cmd_worker boot-run "" "${log}"
}

cmd_save() {
    local c="$1" p="$2" b="$3" why loose text
    need_root
    if [ -n "${c}" ]; then
        valid_path "${c}" || fail "the checkout must be an absolute path without quotes, \$, \` or backslashes"
        why="$(checkout_problem "${c}" strict)"
        [ -z "${why}" ] || fail "${why}"
    fi
    [ -z "${p}" ] || valid_project "${p}" || fail "not a Compose project name: '${p}' (lowercase letters, digits, - and _; see 'docker compose ls')"
    if [ -n "${b}" ]; then
        if ! valid_path "${b}" || ! compose_usable "${b}"; then
            fail "the Compose binary must be an absolute path to an executable file: ${b}"
        fi
        loose="$(find -L "${b}" "$(dirname "${b}")" -maxdepth 0 -perm /022 -printf '%m %p, ' 2>/dev/null)"
        [ -z "${loose}" ] || fail "group or others can write ${loose%, } and root would run it. Repair: chmod go-w $(printf '%q ' "${b}" "$(dirname "${b}")")"
    fi
    text="$(printf '# MCPanel plugin settings (Settings > User Utilities > MCPanel). Empty: found automatically / none.\nCHECKOUT="%s"\nPROJECT="%s"\nCOMPOSE_BIN="%s"' "${c}" "${p}" "${b}")"
    if [ "$(cat "${CFG}" 2>/dev/null)" = "${text}" ]; then
        say "SAVED: nothing changed"
        return 0
    fi
    if ! { mkdir -p "${CFG_DIR}" && say "${text}" >"${CFG}.new" && mv -f "${CFG}.new" "${CFG}"; }; then
        fail "could not write ${CFG}"
    fi
    say "SAVED: ${CFG}"
}

cmd_detect() {
    local line
    while IFS= read -r line; do
        [ -z "${line}" ] || kv DETECTED "${line}"
    done <<<"$(detect_lines)"
}

cmd_facts() {
    local line name compose link plan offer file task_log
    resolve
    kv PLUGIN_VERSION "$(plg_version "${PLG}")"
    kv SET_CHECKOUT "${CHECKOUT_SET}"
    kv SET_PROJECT "${PROJECT_SET}"
    kv SET_COMPOSE_BIN "${COMPOSE_BIN_SET}"
    kv CHECKOUT "${CHECKOUT}"
    kv CHECKOUT_FROM "${CHECKOUT_FROM}"
    [ -z "${CHECKOUT}" ] || kv CHECKOUT_PROBLEM "$(checkout_problem "${CHECKOUT}" strict)"
    kv PROJECT "${PROJECT}"
    kv PROJECT_FROM "${PROJECT_FROM}"
    [ -z "${CHECKOUT}" ] || kv CHECKOUT_PLUGIN_VERSION "$(plg_version "${CHECKOUT}/deploy/unraid/plugin/mcpanel.plg")"
    compose="$(timeout 20 docker compose version 2>/dev/null | head -n 1)"
    kv COMPOSE "${compose}"
    link="$(readlink "${CLI_DIR}/docker-compose" 2>/dev/null)" || link=""
    kv COMPOSE_LINK "${link}"
    # what array-start.sh links at boot when the plugin passes no binary (its own remembered setting)
    kv REMEMBERED_COMPOSE_BIN "$(sed -n 's|^COMPOSE_BIN=\(/.*\)$|\1|p' "${CFG_DIR}/array-start.env" 2>/dev/null | head -n 1)"
    kv OWN_COMPOSE_VERSION "${COMPOSE_VERSION}"
    kv OWN_COMPOSE_SHA256 "${COMPOSE_SHA256}"
    if own_compose_ok; then kv OWN_COMPOSE installed; elif [ -f "${COMPOSE_STORE}" ]; then kv OWN_COMPOSE damaged; else kv OWN_COMPOSE none; fi
    line="$(find "${CLI_DIR%/*}" "${CLI_DIR}" "${LIB_DIR}" -maxdepth 0 -perm /022 ! -perm -1000 -printf '%m %p, ' 2>/dev/null)"
    kv LOOSE_DIRS "${line%, }"
    if [ -x "${PLUGIN_DIR}/event/stopping_docker" ]; then kv HOOK installed; else kv HOOK missing; fi
    if [ -x "${PLUGIN_DIR}/event/docker_started" ]; then kv BOOT_EVENT yes; else kv BOOT_EVENT no; fi
    if busy; then kv BUSY 1; else kv BUSY 0; fi
    # the run folder's files only from a folder of root's that only root can write
    run_dir_ok || kv RUN_DIR_PROBLEM "${RUN_DIR_PROBLEM}"
    for file in "${TASK_FILE}" "${BOOT_FILE}"; do
        run_dir_ok && [ -f "${file}" ] && [ ! -L "${file}" ] || continue
        name=TASK
        [ "${file}" = "${TASK_FILE}" ] || name=BOOT
        while IFS= read -r line; do
            [[ "${line}" =~ ^(TASK|OPTION|PID|STARTED|LOG|RESULT|EXIT|ENDED|NEEDS)=(.*)$ ]] || continue
            kv "${name}_${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        done <"${file}"
    done
    while IFS= read -r task_log; do
        [ -z "${task_log}" ] || kv LOG_FILE "${task_log}"
    done <<<"$(run_dir_ok && find "${LOGS}" -maxdepth 1 -type f -name '*.log' -printf '%f\n' 2>/dev/null | sort -r)"
    ! run_dir_ok || [ ! -f "${UPDATES_FILE}" ] || {
        kv UPDATES_CHECKED "$(file_value "${UPDATES_FILE}" CHECKED)"
        kv PLUGIN_UPSTREAM "$(file_value "${UPDATES_FILE}" PLUGIN_UPSTREAM)"
    }
    # git only in a checkout that only root can change (its config could name commands git runs)
    if [ -n "${CHECKOUT}" ] && [ -d "${CHECKOUT}/.git" ]; then kv GIT yes; elif [ -n "${CHECKOUT}" ]; then kv GIT no; fi
    if [ -n "${CHECKOUT}" ] && [ -z "$(checkout_problem "${CHECKOUT}" strict git)" ]; then
        kv HEAD "$(gitc log -1 --format='%h %s' 2>/dev/null)"
        kv LOCAL_CHANGES "$(local_changes | wc -l)"
        if branch_info >/dev/null 2>&1; then
            kv BRANCH "${BRANCH}"
            kv DETACHED "${DETACHED}"
            kv UPSTREAM "${UPSTREAM#refs/remotes/}"
            if gitc rev-parse -q --verify "${UPSTREAM}" >/dev/null 2>&1; then
                kv BEHIND "$(gitc rev-list --count "HEAD..${UPSTREAM}" 2>/dev/null)"
                kv AHEAD "$(gitc rev-list --count "${UPSTREAM}..HEAD" 2>/dev/null)"
                while IFS= read -r line; do
                    [ -z "${line}" ] || kv UPDATE_COMMIT "${line}"
                done <<<"$(gitc log --format='%h %s' --max-count=50 "HEAD..${UPSTREAM}" 2>/dev/null)"
            fi
        fi
        for plan in update rollback; do
            if offer="$(plan_offer "${plan}" >/dev/null 2>&1 && printf '%s' "${PLAN_OFFER}")"; then
                kv "PLAN_${plan^^}" "${offer}"
            fi
        done
        line="$(timeout 10 docker ps -q --filter "label=com.docker.compose.project=${PROJECT}" --filter label=com.docker.compose.service=panel 2>/dev/null | head -n 1)"
        [ -z "${line}" ] || kv PANEL_PUBLISHED "$(timeout 10 docker port "${line}" 8000/tcp 2>/dev/null | head -n 1)"
    fi
    # what else installs the boot tasks or the hook: not needed with the plugin
    while IFS= read -r file; do
        [ -n "${file}" ] || continue
        name="$(basename "$(dirname "${file}")")"
        [ ! -f "$(dirname "${file}")/name" ] || name="$(head -n 1 "$(dirname "${file}")/name")"
        kv USER_SCRIPT "${name}"
    done <<<"$(grep -l -s -e 'array-start\.sh' -e 'install-hook\.sh' "${USER_SCRIPTS}"/*/script 2>/dev/null)"
    if grep -q -s -e 'install-hook\.sh' -e 'array-start\.sh' "${GO_FILE}"; then kv GO_FILE yes; else kv GO_FILE no; fi
}

command="${1:-}"
[ "$#" -gt 0 ] && shift
case "${command}" in
    facts) [ "$#" -eq 0 ] || usage; cmd_facts ;;
    detect) [ "$#" -eq 0 ] || usage; cmd_detect ;;
    describe) cmd_describe "$@" ;;
    start) cmd_start "$@" ;;
    boot) [ "$#" -eq 0 ] || usage; cmd_boot ;;
    save) [ "$#" -eq 3 ] || usage; cmd_save "$@" ;;
    worker) [ "$#" -eq 3 ] || usage; cmd_worker "$@" ;;
    *) usage ;;
esac
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/mcpanel/event/docker_started" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
# MCPanel plugin: Unraid runs this right after it started Docker (Settings > Docker, or the array start) and
# waits until it ends (emhttp_event). So it only starts the boot tasks in a session of their own and returns:
# the Compose link, the shutdown hook, the firewall where it was installed and the stack check
# (bin/mcpanel boot -> deploy/unraid/array-start.sh run of the checkout). Their log: Settings > User
# Utilities > MCPanel, and the syslog (tag mcpanel).
umask 022
setsid "$(cd "$(dirname "$0")/.." && pwd)/bin/mcpanel" boot </dev/null >/dev/null 2>&1 &
exit 0
]]>
</INLINE>
</FILE>

<!-- 3. modes, the settings folder; nothing is started (at boot Docker is not up yet) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
# MCPanel plugin, last step of every install: the plugin manager makes folders with mode 0770 and files with
# the umask of whoever runs it (000 on some servers): nothing of the plugin may be writable by group or others.
# Nothing is started here: at boot Docker is not up yet (the boot tasks run when it starts: event/docker_started),
# and after an install or update by hand the page offers them.
umask 022
D="${MCPANEL_PLUGIN_ROOT:-}/usr/local/emhttp/plugins/mcpanel"
chmod -R go-w "${D}" || exit 1
chmod 755 "${D}" "${D}/bin" "${D}/event" "${D}/include" || exit 1
chmod 755 "${D}/bin/mcpanel" "${D}/event/docker_started" || exit 1
mkdir -p "${MCPANEL_PLUGIN_ROOT:-}/boot/config/plugins/mcpanel" || exit 1
echo ""
echo "MCPanel plugin installed. Its page: Settings > User Utilities > MCPanel."
echo "At every Docker start it runs the boot tasks of the MCPanel checkout (Compose link, shutdown hook,"
echo "firewall where it was installed, stack check); no User Script is needed for them any more."
echo "NOT RUN ON A REAL UNRAID HOST YET: docs/UNRAID.md has the first-run checklist."
exit 0
]]>
</INLINE>
</FILE>

<!-- removal: the page, the programs, the event scripts and the shutdown hook in the event folder -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
# MCPanel plugin removal: its page, its programs and its event scripts go, the shutdown hook in its event folder
# with them, and its run folder /run/mcpanel (the action logs). Kept: /boot/config/plugins/mcpanel (the settings,
# array-start.env, the Compose copy if it was installed), and until the next boot the Compose link and its copy
# in RAM (docker compose keeps working).
umask 022
R="${MCPANEL_PLUGIN_ROOT:-}"
D="${R}/usr/local/emhttp/plugins/mcpanel"
LOCK="${R}/run/mcpanel/lock"
if [ -e "${LOCK}" ] && command -v flock >/dev/null 2>&1 && ! flock -n "${LOCK}" true; then
    echo "An action of the MCPanel page is still running: remove the plugin when it has ended (the page shows it)."
    exit 1
fi
rm -rf "${D}" "${R}/run/mcpanel"
logger -t mcpanel -- "plugin removed: the shutdown hook and the boot tasks at Docker start are gone" 2>/dev/null || true
echo "MCPanel plugin removed, with the shutdown hook, the boot tasks at Docker start and the action logs."
echo "Kept: /boot/config/plugins/mcpanel (settings, array-start.env, the Compose copy if it was installed: delete"
echo "that folder to remove them). Without the plugin, the User Script of docs/UNRAID.md does the boot tasks."
exit 0
]]>
</INLINE>
</FILE>
</PLUGIN>
