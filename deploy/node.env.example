# Environment for an ADDITIONAL node (a second Docker host managed by the same panel).
# Create the real file with fresh secrets:
#   deploy/scripts/generate-secrets.sh --node        # writes deploy/node.env (mode 600)
# then start the agent:
#   cd deploy && docker compose -f docker-compose.node.yml --env-file node.env up -d --build
# See DEPLOYMENT.md, section "Additional nodes".

TZ=UTC

# --- Secrets (filled in by generate-secrets.sh --node) ---------------------------------
# Bearer token the panel presents to this agent. Paste it into System -> Nodes -> Add node.
AGENT_TOKEN=
# Encryption password of this node's restic backup repositories. Keep a copy elsewhere:
# backups on this node cannot be restored without it.
AGENT_RESTIC_PASSWORD=

# --- Storage ---------------------------------------------------------------------------
# Absolute host path for server folders, backups and agent state (same path is used
# inside the container). On Unraid: /mnt/user/appdata/mcpanel
MCPANEL_DATA_DIR=/srv/mcpanel
# Optional separate backup location (e.g. the array instead of a cache pool).
MCPANEL_BACKUP_DIR=
# UID/GID the Minecraft processes run as (Unraid: 99/100).
MC_UID=1000
MC_GID=1000

# --- Agent API listener ------------------------------------------------------------------
# The agent serves HTTPS with a self-signed certificate (AGENT_TLS=auto); the panel pins it
# by fingerprint. REQUIRED: the IP address of THIS host on the LAN/VPN that the panel uses,
# e.g. 192.168.1.20 or a WireGuard/Tailscale address. The agent can start containers as
# root, so do not use a public interface; 0.0.0.0 (all interfaces) only behind a firewall that
# lets nothing but the panel host reach MCPANEL_NODE_PORT.
MCPANEL_NODE_BIND=
MCPANEL_NODE_PORT=8700
# Extra names/IPs written into the self-signed certificate (informational; the pin is
# what the panel checks). Comma-separated, e.g. node2.lan,192.168.1.20
MCPANEL_NODE_HOSTNAMES=

# --- Policy (optional) -------------------------------------------------------------------
AGENT_PORT_MIN=1024
AGENT_PORT_MAX=65535
AGENT_MAX_MEMORY_MB=65536
AGENT_LOG_LEVEL=INFO
MCPANEL_IMAGE_TAG=local
