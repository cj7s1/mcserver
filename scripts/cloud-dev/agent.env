# Agent settings for the sandboxed cloud dev environment (see egress_forwarder.py)
AGENT_TOKEN=dev-agent-token
AGENT_DATA_ROOT=/srv/mcpanel-dev
AGENT_RUNTIME_EXTRA_ENV='{"HTTPS_PROXY":"http://172.18.0.1:3128","https_proxy":"http://172.18.0.1:3128","SSL_CERT_FILE":"/mcpanel/certs/ca-bundle.crt","JAVA_TOOL_OPTIONS":"-Dhttps.proxyHost=172.18.0.1 -Dhttps.proxyPort=3128 -Djavax.net.ssl.trustStore=/mcpanel/certs/cacerts -Djavax.net.ssl.trustStorePassword=changeit"}'
AGENT_RUNTIME_CA_BUNDLE=/root/.ccr/ca-bundle.crt
AGENT_RUNTIME_JAVA_TRUSTSTORE=/etc/ssl/certs/java/cacerts
